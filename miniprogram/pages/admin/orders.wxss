/* pages/admin/orders.wxss */
page {
  background-color: #f2f2f7;
}

.container {
  min-height: 100vh;
  background: #F5F5F7;
  padding-bottom: 60rpx;
}

/* 顶部导航栏 */
.top-bar {
  background: #fff;
  padding: 60rpx 40rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.02);
  position: relative;
  z-index: 10;
}

.date-trigger {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.date-trigger-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #000;
}

.date-trigger-icon {
  font-size: 32rpx;
  color: #999;
  transition: transform 0.2s ease;
}

.date-trigger-icon.expanded {
  transform: rotate(90deg);
}

.settings-btn {
  display: flex;
  align-items: center;
}

.settings-circle {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 1rpx solid #e5e5ea;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.settings-icon {
  font-size: 28rpx;
  color: #666;
}

/* 日期选择器 */
.date-picker-wrap {
  background: #fff;
  height: 0;
  overflow: hidden;
  transition: height 0.25s ease;
}

.date-picker-wrap.show {
  height: 140rpx;
}

.date-picker {
  height: 140rpx;
  white-space: nowrap;
}

.date-picker-inner {
  display: inline-flex;
  padding: 0 30rpx;
  gap: 20rpx;
}

.date-pick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 80rpx;
  height: 120rpx;
  border-radius: 16rpx;
  padding: 10rpx 16rpx;
}

.date-pick-item.active {
  background: #000;
}

.date-pick-week {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.date-pick-day {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.date-pick-item.active .date-pick-week,
.date-pick-item.active .date-pick-day {
  color: #fff;
}

/* 设置弹窗 */
.popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 200;
  display: flex;
  justify-content: flex-end;
  align-items: flex-start;
  padding-top: 160rpx;
  padding-right: 20rpx;
}

.popup-menu {
  background: #fff;
  border-radius: 20rpx;
  min-width: 280rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.15);
  overflow: hidden;
}

.popup-item {
  padding: 32rpx 40rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.popup-item:last-child {
  border-bottom: none;
}

.popup-text {
  font-size: 32rpx;
  color: #222;
}

.popup-item.logout .popup-text {
  color: #ff3b30;
}

/* 营收卡片 */
.revenue-card {
  display: flex;
  background: #fff;
  margin: 24rpx;
  border-radius: 16rpx;
  padding: 24rpx;
  align-items: center;
}

.revenue-item { 
  flex: 1; 
  text-align: center; 
}

.revenue-num { 
  font-size: 40rpx; 
  font-weight: 600; 
  color: #000; 
}

.revenue-num.actual { 
  color: #34C759; 
}

.revenue-label { 
  font-size: 24rpx; 
  color: #999; 
  margin-top: 4rpx; 
}

.revenue-divider { 
  width: 2rpx; 
  height: 60rpx; 
  background: #eee; 
}

/* 品类统计 */
.stats-list { 
  padding: 16rpx 24rpx; 
  background: #F2F2F7; 
  border-radius: 20rpx; 
  margin: 0 24rpx; 
}

.stat-card { 
  background: #fff; 
  border-radius: 20rpx; 
  padding: 24rpx; 
  margin-bottom: 20rpx; 
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); 
}

.stat-card:last-child { 
  margin-bottom: 0; 
}

.stat-header { 
  display: flex; 
  justify-content: space-between; 
  align-items: center; 
  margin-bottom: 16rpx; 
}

.stat-name { 
  font-size: 32rpx; 
  font-weight: 600; 
  color: #222; 
}

.stat-badges { 
  display: flex; 
  gap: 8rpx; 
}

.customer-item { 
  font-size: 28rpx; 
  color: #333; 
}

.at-symbol { 
  color: #007AFF; 
  font-weight: 500; 
}

.separator { 
  color: #ccc; 
  margin: 0 2rpx; 
}

.stats-empty { 
  text-align: center; 
  color: #999; 
  padding: 40rpx; 
}

/* 订单区域 */
.order-section { 
  padding: 24rpx; 
}

.section-title { 
  font-size: 32rpx; 
  font-weight: 600; 
  color: #222; 
  margin-bottom: 16rpx; 
}

.section-title.done { 
  color: #999; 
}

.count-badge { 
  background: #000; 
  color: #fff; 
  font-size: 24rpx; 
  padding: 4rpx 12rpx; 
  border-radius: 12rpx; 
  margin-left: 8rpx; 
}

.count-badge.done { 
  background: #999; 
}

.order-list {
  padding: 8rpx 0;
}

.order-card { 
  background: #fff; 
  border-radius: 16rpx; 
  padding: 24rpx; 
  margin-bottom: 16rpx; 
}

.order-card.done { 
  opacity: 0.6; 
}

.order-user {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.order-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
}

.order-avatar-placeholder {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.order-user-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.order-top { 
  display: flex; 
  justify-content: space-between; 
  margin-bottom: 12rpx; 
}

.order-name { 
  font-size: 32rpx; 
  font-weight: 600; 
  color: #222; 
}

.order-name.dimmed { 
  color: #999; 
}

.order-time { 
  font-size: 26rpx; 
  color: #666; 
}

.order-items { 
  margin-bottom: 16rpx; 
}

.order-items.dimmed { 
  opacity: 0.6; 
}

.item-tag { 
  display: inline-block; 
  background: #f5f5f5; 
  padding: 6rpx 16rpx; 
  border-radius: 20rpx; 
  font-size: 26rpx; 
  color: #555; 
  margin: 4rpx 8rpx 4rpx 0; 
}

.order-bottom { 
  display: flex; 
  justify-content: space-between; 
  align-items: center; 
}

.order-price { 
  font-size: 36rpx; 
  font-weight: 700; 
  color: #ff9500; 
}

.order-price.dimmed { 
  color: #999; 
}

.order-btns { 
  display: flex; 
  gap: 12rpx; 
}

.btn-take { 
  flex: 2;
  background: #007AFF; 
  color: #fff; 
  border: none; 
  border-radius: 16rpx; 
  font-size: 30rpx; 
  padding: 20rpx 32rpx; 
  font-weight: 600; 
  min-height: 60rpx;
  line-height: 1.4;
}

.btn-cancel { 
  flex: 1;
  background: #fff; 
  color: #FF3B30; 
  border: 2rpx solid #FF3B30; 
  border-radius: 16rpx; 
  font-size: 28rpx; 
  padding: 20rpx 32rpx; 
  min-height: 60rpx;
  line-height: 1.4;
}

.btn-take:active { 
  background: #0051D5; 
  transform: scale(0.96); 
}

.btn-cancel { 
  background: #fff; 
  color: #FF3B30; 
  border: 2rpx solid #FF3B30; 
  border-radius: 16rpx; 
  font-size: 28rpx; 
  padding: 16rpx 32rpx; 
  min-height: 56rpx;
  line-height: 1.4;
}

.btn-cancel:active { 
  background: rgba(255, 59, 48, 0.1); 
  transform: scale(0.96); 
}

.btn-undo { 
  background: #F2F2F7; 
  color: #6E6E73; 
  border: none; 
  border-radius: 16rpx; 
  font-size: 28rpx; 
  padding: 16rpx 32rpx; 
  min-height: 56rpx;
  line-height: 1.4;
}

.btn-undo:active { 
  background: #E5E5EA; 
  transform: scale(0.96); 
}

/* 状态标签 */
.tag-pending, .tag-completed, .tag-cancelled { 
  font-size: 24rpx; 
  padding: 4rpx 12rpx; 
  border-radius: 8rpx; 
}

.tag-pending { 
  background: #FFF3CD; 
  color: #B8860B; 
}

.tag-completed { 
  background: #D4EDDA; 
  color: #155724; 
}

.tag-cancelled { 
  background: #F8D7DA; 
  color: #721C24; 
}

/* 新订单提示 */
.new-order-tip { 
  background: #000; 
  color: #fff; 
  text-align: center; 
  padding: 12rpx; 
  font-size: 26rpx; 
  font-weight: 600; 
}

/* 历史订单详情弹窗 */
.detail-popup {
  width: 90%;
  max-height: 85%;
  background: #f8f8f8;
  border-radius: 24rpx;
  overflow: hidden;
}

.detail-header {
  display: flex; 
  align-items: center; 
  justify-content: space-between;
  padding: 24rpx 32rpx; 
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-title { 
  font-size: 36rpx; 
  font-weight: bold; 
  color: #222; 
}

.detail-count { 
  font-size: 28rpx; 
  color: #888; 
}

.detail-list {
  max-height: 70vh; 
  padding: 16rpx;
}

.detail-item {
  display: flex; 
  align-items: flex-start; 
  gap: 16rpx;
  background: #fff; 
  border-radius: 16rpx; 
  padding: 20rpx; 
  margin-bottom: 12rpx;
}

.detail-item-top { 
  display: flex; 
  justify-content: space-between; 
  margin-bottom: 12rpx; 
}

.detail-name { 
  font-size: 32rpx; 
  font-weight: bold; 
  color: #222; 
}

.detail-items { 
  margin-bottom: 12rpx; 
}

.detail-item-bottom { 
  display: flex; 
  justify-content: space-between; 
  align-items: center; 
}

.detail-price { 
  font-size: 32rpx; 
  font-weight: bold; 
  color: #ff6b35; 
}

.btn-delete {
  font-size: 26rpx; 
  color: #ff3b30; 
  background: #fff; 
  border: 2rpx solid #ff3b30;
  border-radius: 8rpx; 
  padding: 8rpx 20rpx;
}
