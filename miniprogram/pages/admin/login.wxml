<view class="container">
  <view class="logo-area">
    <view class="logo-icon">🍞</view>
    <view class="logo-title">馒头店管理</view>
    <view class="logo-sub">店主专属入口</view>
  </view>

  <view class="form-card">
    
    <view class="form-item">
      <view class="form-label">手机号</view>
      <input 
        class="form-input" 
        type="number" 
        placeholder="请输入手机号" 
        placeholder-class="placeholder-style" 
        value="{{username}}" 
        bindinput="onUsernameInput" 
        maxlength="11" 
        adjust-position="{{false}}"
      />
    </view>

    <view class="form-item">
      <view class="form-label">密码</view>
      <input 
        class="form-input" 
        password 
        placeholder="请输入密码" 
        placeholder-class="placeholder-style"
        value="{{password}}" 
        bindinput="onPasswordInput" 
        adjust-position="{{false}}"
      />
    </view>
    
    <button 
      class="btn-login" 
      bindtap="doLogin" 
      loading="{{loading}}"
    >登 录</button>

  </view> </view>