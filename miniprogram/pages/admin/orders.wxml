<!--pages/admin/orders.wxml-->
<view class="container">
  <!-- 顶部导航栏 - 复用用户端设计 -->
  <view class="top-bar">
    <view class="date-trigger" bindtap="toggleDatePicker">
      <text class="date-trigger-text">{{currentDateLabel}}</text>
      <text class="date-trigger-icon {{showDatePicker ? 'expanded' : ''}}">›</text>
    </view>
    <view class="settings-btn" bindtap="showMenu">
      <view class="settings-circle">
        <text class="settings-icon">⚙</text>
      </view>
    </view>
  </view>

  <!-- 日期选择器 -->
  <view class="date-picker-wrap {{showDatePicker ? 'show' : ''}}">
    <scroll-view class="date-picker" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="date-picker-inner">
        <view wx:for="{{dateList}}" wx:key="date" class="date-pick-item {{item.date === currentDate ? 'active' : ''}}" bindtap="onDateSelect" data-date="{{item.date}}">
          <text class="date-pick-week">{{item.label}}</text>
          <text class="date-pick-day">{{item.day}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 二级导航 -->
  <view class="sub-nav">
    <view class="sub-item {{subTab === 'verify' ? 'active' : ''}}" bindtap="switchSubTab" data-tab="verify">预定核销</view>
    <view class="sub-item {{subTab === 'menu' ? 'active' : ''}}" bindtap="switchSubTab" data-tab="menu">菜单管理</view>
  </view>

  <!-- 新订单提示 -->
  <view class="new-order-tip" wx:if="{{newOrderFlag}}">新订单!</view>

  <!-- ==================== 预定核销 ==================== -->
  <view wx:if="{{subTab === 'verify'}}">
    <!-- 区域1：动态看板 -->
    <view class="dashboard">
      <view class="dashboard-title">今日看板</view>

      <view class="revenue-row">
        <view class="revenue-item">
          <view class="revenue-num">{{totalRevenue}}</view>
          <view class="revenue-label">预计</view>
        </view>
        <view class="revenue-divider"></view>
        <view class="revenue-item">
          <view class="revenue-num actual">{{actualRevenue}}</view>
          <view class="revenue-label">实收</view>
        </view>
      </view>

      <view class="stats-list">
        <view wx:for="{{menuStats}}" wx:key="name" class="stat-card">
          <view class="stat-header">
            <text class="stat-name">{{item.name}}</text>
            <view class="stat-badges">
              <text class="badge-total">总订 {{item.total}}</text>
              <text class="badge-pending">待取 {{item.pending}}</text>
            </view>
          </view>
          <view wx:if="{{item.customers.length > 0}}" class="stat-customers">
            <text wx:for="{{item.customers}}" wx:for-item="c" wx:key="orderId" class="customer-tag">
              {{c.name}}×{{c.num}}
            </text>
          </view>
          <view wx:if="{{item.customers.length === 0}}" class="stat-empty">暂无预定</view>
        </view>
        <view wx:if="{{menuStats.length === 0}}" class="stats-empty">暂无数据</view>
      </view>
    </view>

    <!-- 区域2：客户清单 -->
    <view class="customer-section">
      <view class="section-title">待处理 ({{pendingOrders.length}})</view>

      <view wx:if="{{pendingOrders.length === 0}}" class="empty-inline">暂无待处理订单</view>
      <view class="customer-list">
        <view class="customer-card" wx:for="{{pendingOrders}}" wx:key="_id">
          <view class="customer-header">
            <image class="customer-avatar" src="{{item.customer_avatar}}" mode="aspectFill" wx:if="{{item.customer_avatar}}"></image>
            <view class="customer-avatar-placeholder" wx:else>?</view>
            <view class="customer-name">
              <text wx:if="{{item.create_time_str}}" class="order-time-badge">{{item.create_time_str}}</text>
              {{item.customer_nickname || item.customer_name}}
            </view>
          </view>
          <view class="customer-items">
            <text wx:for="{{item.items}}" wx:for-item="prod" wx:key="name" class="customer-item-tag">{{prod.name}}×{{prod.num}}</text>
          </view>
          <view class="customer-footer">
            <view class="customer-price">¥{{item.total_price}}</view>
            <view class="customer-actions">
              <button class="btn-verify" bindtap="verifyOrder" data-id="{{item._id}}">取走</button>
              <button class="btn-cancel-order" bindtap="cancelOrder" data-id="{{item._id}}">取消</button>
            </view>
          </view>
        </view>
      </view>

      <view wx:if="{{historyOrders.length > 0}}" class="history-section">
        <view class="section-title grey">已处理 ({{historyOrders.length}})</view>
        <view class="customer-list">
          <view class="customer-card handled {{item.status === 'cancelled' ? 'cancelled' : ''}}" wx:for="{{historyOrders}}" wx:key="_id">
            <view class="customer-header">
              <view class="customer-name dimmed">
                <text wx:if="{{item.create_time_str}}" class="order-time-badge grey-badge">{{item.create_time_str}}</text>
                {{item.customer_name}}
              </view>
              <text class="tag-{{item.status}}">{{statusText[item.status]}}</text>
            </view>
            <view class="customer-items dimmed">
              <text wx:for="{{item.items}}" wx:for-item="prod" wx:key="name" class="customer-item-tag">{{prod.name}}×{{prod.num}}</text>
            </view>
            <view class="customer-footer">
              <view class="customer-price dimmed">¥{{item.total_price}}</view>
              <view class="customer-actions">
                <button class="btn-undo" bindtap="undoAction" data-id="{{item._id}}" data-status="{{item.status}}">撤销</button>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- ==================== 菜单管理 ==================== -->
  <view wx:if="{{subTab === 'menu'}}">
    <view class="menu-manage-section">
      <view class="menu-manage-btn" bindtap="goMenu">
        <text class="menu-icon">📋</text>
        <text class="menu-text">发布/管理菜单</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 设置弹窗 -->
  <view wx:if="{{showSettings}}" class="popup-mask" bindtap="closeSettings">
    <view class="popup-menu" catchtap>
      <view class="popup-item" bindtap="goProducts">
        <text class="popup-text">产品池</text>
      </view>
      <view class="popup-item" bindtap="goHistory">
        <text class="popup-text">历史订单</text>
      </view>
      <view class="popup-item logout" bindtap="doLogout">
        <text class="popup-text">退出登录</text>
      </view>
    </view>
  </view>
</view>