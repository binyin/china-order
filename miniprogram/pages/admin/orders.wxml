<!--pages/admin/orders.wxml-->
<view class="container">
  <!-- 顶部导航栏 -->
  <view class="top-bar">
    <view class="date-trigger" bindtap="toggleDatePicker">
      <text class="date-trigger-text">{{currentDateLabel}}</text>
      <text class="date-trigger-icon {{showDatePicker ? 'expanded' : ''}}">›</text>
    </view>
    <switch class="mode-switch" wx:if="{{menuClickCount >= 5}}" checked="{{orderMode === 'order'}}" bindchange="toggleOrderMode" />
    <view class="settings-btn" bindtap="showMenu">
      <view class="settings-circle">
        <text class="settings-icon">⚙</text>
      </view>
    </view>
  </view>

  <!-- 日期选择器 -->
  <view class="date-picker-wrap {{showDatePicker ? 'show' : ''}}">
    <scroll-view class="date-picker" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="date-picker-inner">
        <view wx:for="{{dateList}}" wx:key="date" class="date-pick-item {{item.date === currentDate ? 'active' : ''}}" bindtap="onDateSelect" data-date="{{item.date}}">
          <text class="date-pick-week">{{item.label}}</text>
          <text class="date-pick-day">{{item.day}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 新订单提示 -->
  <view class="new-order-tip" wx:if="{{newOrderFlag}}">新订单!</view>

  <!-- 营收卡片 -->
  <view class="revenue-card">
    <view class="revenue-item">
      <view class="revenue-num">{{totalRevenue}}</view>
      <view class="revenue-label">预计</view>
    </view>
    <view class="revenue-divider"></view>
    <view class="revenue-item">
      <view class="revenue-num actual">{{actualRevenue}}</view>
      <view class="revenue-label">实收</view>
    </view>
  </view>

  <!-- 品类统计 -->
  <view class="stats-list">
    <view wx:for="{{menuStats}}" wx:key="name" class="stat-card">
      <view class="stat-header">
        <text class="stat-name">{{item.name}}</text>
        <view class="stat-badges">
          <text class="badge-total">{{item.total}}</text>
          <text class="badge-pending" wx:if="{{item.pending > 0}}">待{{item.pending}}</text>
        </view>
      </view>
      <view wx:if="{{item.customers.length > 0}}" class="stat-customers">
        <text wx:for="{{item.customers}}" wx:for-item="c" wx:key="orderId" class="customer-tag">{{c.name}}×{{c.num}}</text>
      </view>
    </view>
    <view wx:if="{{menuStats.length === 0}}" class="stats-empty">暂无预定</view>
  </view>

  <!-- 待处理订单 -->
  <view class="order-section" wx:if="{{pendingOrders.length > 0}}">
    <view class="section-title">待处理 <text class="count-badge">{{pendingOrders.length}}</text></view>
    <view class="order-list">
      <view class="order-card" wx:for="{{pendingOrders}}" wx:key="_id">
        <view class="order-top">
          <text class="order-name">{{item.customer_nickname || item.customer_name}}</text>
          <text class="order-time">{{item.create_time_str}}</text>
        </view>
        <view class="order-items">
          <text wx:for="{{item.items}}" wx:for-item="prod" wx:key="name" class="item-tag">{{prod.name}}×{{prod.num}}</text>
        </view>
        <view class="order-bottom">
          <text class="order-price">¥{{item.total_price}}</text>
          <view class="order-btns">
            <button class="btn-take" bindtap="verifyOrder" data-id="{{item._id}}">取走</button>
            <button class="btn-cancel" bindtap="cancelOrder" data-id="{{item._id}}">取消</button>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 已处理订单 -->
  <view class="order-section" wx:if="{{historyOrders.length > 0}}">
    <view class="section-title done">已处理 <text class="count-badge done">{{historyOrders.length}}</text></view>
    <view class="order-list">
      <view class="order-card done" wx:for="{{historyOrders}}" wx:key="_id">
        <view class="order-top">
          <text class="order-name dimmed">{{item.customer_name}}</text>
          <text class="tag-{{item.status}}">{{statusText[item.status]}}</text>
        </view>
        <view class="order-items dimmed">
          <text wx:for="{{item.items}}" wx:for-item="prod" wx:key="name" class="item-tag">{{prod.name}}×{{prod.num}}</text>
        </view>
        <view class="order-bottom">
          <text class="order-price dimmed">¥{{item.total_price}}</text>
          <button class="btn-undo" bindtap="undoAction" data-id="{{item._id}}" data-status="{{item.status}}">撤销</button>
        </view>
      </view>
    </view>
  </view>

  <!-- 设置弹窗 -->
  <view wx:if="{{showSettings}}" class="popup-mask" bindtap="closeSettings">
    <view class="popup-menu" catchtap>
      <view class="popup-item" bindtap="goMenu">
        <text class="popup-text">菜单管理</text>
      </view>
      <view class="popup-item" bindtap="goProducts">
        <text class="popup-text">产品池</text>
      </view>
      <view class="popup-item" bindtap="goHistory">
        <text class="popup-text">历史订单</text>
      </view>
      <view class="popup-item logout" bindtap="doLogout">
        <text class="popup-text">退出登录</text>
      </view>
    </view>
  </view>

  <!-- 历史订单详情弹窗 -->
  <view wx:if="{{showDetail}}" class="popup-mask" bindtap="backToList">
    <view class="detail-popup" catchtap>
      <view class="detail-header">
        <text class="detail-title">{{detailDate}}</text>
        <text class="detail-count">共{{detailOrders.length}}单</text>
      </view>
      <scroll-view scroll-y class="detail-list">
        <view class="detail-item" wx:for="{{detailOrders}}" wx:key="_id">
          <view class="detail-item-top">
            <text class="detail-name">{{item.customer_nickname || item.customer_name}}</text>
            <text class="tag-{{item.status}}">{{statusText[item.status]}}</text>
          </view>
          <view class="detail-items">
            <text wx:for="{{item.items}}" wx:for-item="prod" wx:key="name" class="item-tag">{{prod.name}}×{{prod.num}}</text>
          </view>
          <view class="detail-item-bottom">
            <text class="detail-price">¥{{item.total_price}}</text>
            <button class="btn-delete" catchtap="deleteOrder" data-id="{{item._id}}" wx:if="{{item.status !== 'pending'}}">删除</button>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
</view>