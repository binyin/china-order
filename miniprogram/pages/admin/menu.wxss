/* pages/admin/menu.wxss */

.container {
  min-height: 100vh;
  background-color: #F8F8F8;
  padding-bottom: 140rpx;
}

/* 顶部导航 */
.nav-header {
  background-color: #ffffff;
  padding: 24rpx 28rpx 20rpx;
  position: sticky;
  top: 0;
  z-index: 100;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.nav-content {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.nav-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #1d1d1f;
  letter-spacing: -0.5rpx;
}

.nav-subtitle {
  font-size: 22rpx;
  color: #86868b;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}

.nav-action {
  display: flex;
  align-items: center;
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 28rpx;
  background-color: #34C759;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(52, 199, 89, 0.3);
}

.action-btn:active {
  transform: scale(0.96);
  opacity: 0.9;
}

.action-icon {
  font-size: 28rpx;
}

.action-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
}

.date-picker {
  width: 100%;
  height: 120rpx;
  white-space: nowrap;
}

.date-list {
  display: inline-flex;
  padding: 0 24rpx;
  gap: 16rpx;
}

.date-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 140rpx;
  height: 96rpx;
  padding: 0 32rpx;
  border-radius: 24rpx;
  background-color: #F5F5F7;
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  user-select: none;
}

.date-item.active {
  background-color: #34C759;
  transform: scale(1.08);
  box-shadow: 0 8rpx 24rpx rgba(52, 199, 89, 0.3);
}

.date-item .date-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #86868b;
}

.date-item.active .date-label {
  color: #ffffff;
}

.date-item .date-val {
  font-size: 22rpx;
  color: #aeaeb2;
  margin-top: 2rpx;
}

.date-item.active .date-val {
  color: rgba(255, 255, 255, 0.8);
}

.date-item:active {
  transform: scale(0.95);
}

.date-item.active:active {
  transform: scale(1.05);
}

/* Tab切换 */
.tab-bar {
  display: flex;
  background-color: #ffffff;
  padding: 0 28rpx;
  border-bottom: 1rpx solid #F5F5F7;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 24rpx 0;
  position: relative;
}

.tab-item.active {
  color: #34C759;
}

.tab-icon {
  font-size: 32rpx;
}

.tab-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #aeaeb2;
}

.tab-item.active .tab-text {
  color: #34C759;
}

/* 清空旧日期样式占位 */

/* 区块 */
.section {
  margin-top: 40rpx;
}

.section-header {
  padding: 0 28rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-header.published {
  border-left: 6rpx solid #34C759;
  padding-left: 20rpx;
}

.section-header.pool {
  border-left: 6rpx solid #007AFF;
  padding-left: 20rpx;
}

.section-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-icon {
  font-size: 32rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1d1d1f;
}

.section-count {
  font-size: 26rpx;
  color: #34C759;
  font-weight: 600;
  background-color: rgba(52, 199, 89, 0.1);
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
}

.section-hint {
  font-size: 24rpx;
  color: #aeaeb2;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 28rpx;
  background-color: #F5F5F7;
  margin: 0 28rpx;
  border-radius: 24rpx;
  gap: 8rpx;
  border: 2rpx dashed #e5e5ea;
}

.empty-icon {
  font-size: 56rpx;
  margin-bottom: 8rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #86868b;
  font-weight: 500;
}

.empty-hint {
  font-size: 26rpx;
  color: #aeaeb2;
}

/* 通用列表样式 */
.item-list {
  padding: 0 28rpx 40rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.item-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  transition: all 0.2s;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.item-card.published {
  border: 1rpx solid rgba(52, 199, 89, 0.2);
}

.item-card.pool {
  border: 1rpx solid rgba(0, 122, 255, 0.15);
}

.item-card:active {
  transform: scale(0.98);
  box-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.04);
}

.item-main {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.item-name {
  font-size: 32rpx;
  color: #1d1d1f;
  font-weight: 500;
}

.item-price {
  font-size: 28rpx;
  color: #1d1d1f;
  font-weight: 600;
  font-family: ui-monospace, "SF Mono", monospace;
}

.item-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.stock-control {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.stock-label {
  font-size: 24rpx;
  color: #86868b;
}

.stock-input {
  width: 72rpx;
  padding: 10rpx 12rpx;
  border-radius: 10rpx;
  background-color: #F5F5F7;
  border: none;
  font-size: 26rpx;
  text-align: center;
  color: #1d1d1f;
}

.btn-remove {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(255, 59, 48, 0.1);
  border-radius: 16rpx;
}

.btn-remove .btn-icon {
  font-size: 24rpx;
  color: #FF3B30;
}

.btn-remove:active {
  transform: scale(0.9);
}

.btn-add {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(52, 199, 89, 0.15);
  border-radius: 16rpx;
}

.btn-add .btn-icon {
  font-size: 32rpx;
  color: #34C759;
  font-weight: 600;
}

.btn-add:active {
  transform: scale(0.9);
  background-color: rgba(52, 199, 89, 0.25);
}

/* 历史菜单 */
.history-section {
  padding: 40rpx 28rpx;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 20rpx;
}

.history-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.history-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.history-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.history-date {
  font-size: 32rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.history-count {
  font-size: 24rpx;
  color: #aeaeb2;
  background-color: #F5F5F7;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.btn-reuse {
  background-color: #007AFF;
  color: #ffffff;
  border-radius: 14rpx;
  padding: 14rpx 24rpx;
  font-size: 26rpx;
  font-weight: 600;
  min-height: auto;
}

.btn-reuse:active {
  background-color: #0066CC;
  transform: scale(0.96);
}

.history-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.history-tag {
  display: inline-block;
  background: #F5F5F7;
  color: #1d1d1f;
  font-size: 26rpx;
  padding: 10rpx 16rpx;
  border-radius: 12rpx;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: var(--spacing-20) 0;
  color: var(--color-text-tertiary);
  font-size: var(--font-size-md);
}

/* 空状态提示 */
.empty-tip {
  text-align: center;
  padding: 80rpx 32rpx;
  color: #86868b;
  font-size: 28rpx;
}

.empty-inline {
  text-align: center;
  padding: 40rpx 24rpx;
  color: #86868b;
  font-size: 28rpx;
}
