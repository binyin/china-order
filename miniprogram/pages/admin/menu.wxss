/* pages/admin/menu.wxss */

.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 顶部导航 */
.nav-header {
  background-color: #ffffff;
  padding: 24rpx;
  position: sticky;
  top: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.nav-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.nav-date {
  display: flex;
  gap: 12rpx;
}

.date-tab {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #666;
  background-color: #f5f5f5;
}

.date-tab.active {
  background-color: #ff6b35;
  color: #ffffff;
}

/* Tab切换 */
.tab-bar {
  display: flex;
  background-color: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
  position: sticky;
  top: 88rpx;
  z-index: 90;
}

.tab-item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  padding: 24rpx 0;
  position: relative;
}

.tab-item.active {
  color: #ff6b35;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 25%;
  right: 25%;
  height: 4rpx;
  background-color: #ff6b35;
  border-radius: 2rpx;
}

.date-scroll {
  white-space: nowrap;
  height: 140rpx;
  width: 100%;
  -webkit-overflow-scrolling: touch;
}

.date-list {
  display: inline-flex;
  padding: 0 var(--spacing-4);
}

.date-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-3) var(--spacing-5);
  margin: 0 var(--spacing-2);
  border-radius: var(--radius-lg);
  background-color: var(--color-gray-50);
  min-width: 160rpx;
  transition: all var(--transition-normal);
  user-select: none;
}

.date-label {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.date-val {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}

.date-item.active {
  background-color: var(--color-primary);
  color: var(--color-white);
  transform: translateY(-2rpx);
  box-shadow: var(--shadow-md);
}

.date-display {
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-semibold);
  margin-bottom: var(--spacing-1);
}

.date-detail {
  font-size: var(--font-size-xs);
  opacity: 0.9;
}

.selected-date-info {
  text-align: center;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  margin-top: var(--spacing-3);
  padding: 0 var(--spacing-4);
}

/* 区块标题 */
.section-header {
  background-color: var(--color-bg-card);
  padding: var(--spacing-4);
  margin-top: var(--spacing-3);
  border-bottom: 1rpx solid var(--color-border-light);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.btn-publish {
  background-color: #ff6b35;
  color: #ffffff;
  border-radius: var(--radius-md);
  padding: var(--spacing-2) var(--spacing-4);
  font-size: var(--font-size-sm);
  min-height: auto;
}

.btn-publish:active {
  background-color: #e05a2b;
}

/* 移除计数显示 */
.section-count,
.section-count.hint {
  display: none;
}

.empty-inline {
  text-align: center;
  padding: var(--spacing-8) var(--spacing-4);
  color: var(--color-text-tertiary);
  font-size: var(--font-size-base);
}

/* 今日售卖列表 */
.today-list {
  padding: 24rpx 0;
}

.today-item {
  background-color: #ffffff;
  border-radius: 16rpx;
  margin: 0 32rpx 24rpx;
  padding: 32rpx;
  border-left: 6rpx solid #ff6b35;
  /* box-shadow: var(--shadow-sm); */
}

.today-info {
  flex: 1;
}

.today-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

.today-meta {
  font-size: 28rpx;
  color: #666666;
  display: flex;
  align-items: center;
  gap: 32rpx;
}

/* 发布时间显示 */
.publish-time {
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

.stock-inline {
  width: 100rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background-color: #f5f5f5;
  border: 1rpx solid #d0d0d0;
  font-size: 28rpx;
  text-align: center;
}

.today-ordered {
  font-size: 28rpx;
  color: #ff6b35;
  font-weight: 600;
  margin: 0 24rpx;
}

.btn-remove {
  background-color: #ffffff;
  color: #ff4d4f;
  border: 1rpx solid #ff4d4f;
  padding: 8rpx 24rpx;
  font-size: 28rpx;
  min-height: auto;
}

.btn-remove:active {
  background-color: #ff4d4f;
  color: #ffffff;
}

/* 未上架产品列表 */
.unlisted-list {
  padding: 24rpx 0;
}

.unlisted-item {
  background-color: #ffffff;
  border-radius: 16rpx;
  margin: 0 32rpx 24rpx;
  padding: 32rpx;
  /* box-shadow: var(--shadow-sm); */
  border: 1rpx solid #e0e0e0;
  transition: transform 0.2s;
}

.unlisted-item:active {
  transform: translateY(-2rpx);
}

.unlisted-info {
  flex: 1;
}

.unlisted-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

.unlisted-price {
  font-size: 28rpx;
  color: #ff6b35;
}

.stock-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 0 24rpx;
}

.stock-label {
  font-size: 28rpx;
  color: #666666;
}

.stock-input {
  width: 100rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background-color: #f5f5f5;
  border: 1rpx solid #d0d0d0;
  font-size: 32rpx;
  text-align: center;
}

.btn-add {
  background-color: #ff6b35;
  color: #ffffff;
  border-radius: 12rpx;
  padding: 8rpx 24rpx;
  font-size: 28rpx;
  min-height: auto;
}

.btn-add:active {
  background-color: #e05a2b;
}

/* 历史菜单 */
.history-list {
  padding: var(--spacing-3) 0 var(--spacing-12);
}

.history-day {
  background-color: var(--color-bg-card);
  border-radius: var(--radius-lg);
  margin: 0 var(--spacing-4) var(--spacing-3);
  padding: var(--spacing-4);
  box-shadow: var(--shadow-sm);
}

.history-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--spacing-3);
  padding-bottom: var(--spacing-2);
  border-bottom: 1rpx solid var(--color-border-light);
}

.history-date {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.btn-reuse {
  background-color: var(--color-primary);
  color: var(--color-white);
  border-radius: var(--radius-md);
  padding: var(--spacing-1) var(--spacing-4);
  font-size: var(--font-size-sm);
  min-height: auto;
}

.btn-reuse:active {
  background-color: var(--color-primary-dark);
}

.history-items {
  line-height: var(--line-height-relaxed);
}

.history-tag {
  display: inline-block;
  background-color: var(--color-gray-50);
  color: var(--color-text-primary);
  font-size: var(--font-size-sm);
  padding: var(--spacing-1) var(--spacing-3);
  border-radius: var(--radius-full);
  margin: 0 var(--spacing-1) var(--spacing-1) 0;
  border: 1rpx solid var(--color-border-light);
}

/* 提示条 */
.tip-bar {
  background-color: var(--color-primary-light);
  color: var(--color-text-primary);
  font-size: var(--font-size-sm);
  padding: var(--spacing-3) var(--spacing-4);
  border-bottom: 1rpx solid rgba(255, 107, 53, 0.2);
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: var(--spacing-20) 0;
  color: var(--color-text-tertiary);
  font-size: var(--font-size-md);
}

/* 空状态提示 */
.empty-tip {
  text-align: center;
  padding: var(--spacing-20) var(--spacing-4);
  color: var(--color-text-tertiary);
  font-size: var(--font-size-md);
}
