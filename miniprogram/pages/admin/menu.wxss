/* pages/admin/menu.wxss */

.container {
  min-height: 100vh;
  background-color: #F5F5F7;
  padding-bottom: 60rpx;
}

/* 顶部导航 */
.nav-header {
  background-color: #ffffff;
  padding: 32rpx 28rpx;
  position: sticky;
  top: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.nav-content {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.nav-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1d1d1f;
  letter-spacing: -0.5rpx;
}

.nav-subtitle {
  font-size: 22rpx;
  color: #86868b;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}

.nav-date {
  display: flex;
  gap: 12rpx;
}

.date-tab {
  padding: 14rpx 24rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #86868b;
  background-color: #F5F5F7;
  font-weight: 500;
  transition: all 0.2s;
}

.date-tab.active {
  background-color: #000000;
  color: #ffffff;
  font-weight: 600;
}

.date-tab:active {
  transform: scale(0.96);
}

/* Tab切换 */
.tab-bar {
  display: flex;
  background-color: #ffffff;
  border-bottom: 1rpx solid #e5e5ea;
  position: sticky;
  top: 124rpx;
  z-index: 90;
}

.tab-item {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  color: #86868b;
  padding: 24rpx 0;
  position: relative;
  font-weight: 500;
}

.tab-item.active {
  color: #000000;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 44rpx;
  height: 6rpx;
  background-color: #000000;
  border-radius: 3rpx;
}

.date-scroll {
  white-space: nowrap;
  height: 140rpx;
  width: 100%;
  -webkit-overflow-scrolling: touch;
}

.date-list {
  display: inline-flex;
  padding: 0 var(--spacing-4);
}

.date-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-3) var(--spacing-5);
  margin: 0 var(--spacing-2);
  border-radius: var(--radius-lg);
  background-color: var(--color-gray-50);
  min-width: 160rpx;
  transition: all var(--transition-normal);
  user-select: none;
}

.date-label {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.date-val {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}

.date-item.active {
  background-color: var(--color-primary);
  color: var(--color-white);
  transform: translateY(-2rpx);
  box-shadow: var(--shadow-md);
}

.date-display {
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-semibold);
  margin-bottom: var(--spacing-1);
}

.date-detail {
  font-size: var(--font-size-xs);
  opacity: 0.9;
}

.selected-date-info {
  text-align: center;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  margin-top: var(--spacing-3);
  padding: 0 var(--spacing-4);
}

/* 区块标题 */
.section-header {
  background-color: #ffffff;
  padding: 24rpx;
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.btn-publish {
  background-color: #000000;
  color: #ffffff;
  border-radius: 16rpx;
  padding: 16rpx 28rpx;
  font-size: 28rpx;
  font-weight: 600;
  min-height: auto;
}

.btn-publish:active {
  background-color: #333333;
  transform: scale(0.96);
}

/* 移除计数显示 */
.section-count,
.section-count.hint {
  display: none;
}

.empty-inline {
  text-align: center;
  padding: 64rpx 24rpx;
  color: #999;
  font-size: 28rpx;
}

/* 通用列表样式 */
.item-list {
  padding: 24rpx;
  background-color: #F5F5F7;
}

.item-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 12rpx;
  transition: transform 0.2s;
}

.item-row:active {
  transform: scale(0.98);
}

.item-row:first-child {
  border-top: 1rpx solid #e5e5ea;
}

.item-main {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.item-name {
  font-size: 30rpx;
  color: #1d1d1f;
  font-weight: 500;
}

.item-price {
  font-size: 26rpx;
  color: #000000;
  font-weight: 600;
  font-family: ui-monospace, "SF Mono", monospace;
}

.item-sub {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-right: 20rpx;
}

.item-stock {
  font-size: 24rpx;
  color: #86868b;
}

.stock-input {
  width: 80rpx;
  padding: 8rpx 12rpx;
  border-radius: 8rpx;
  background-color: #f2f2f7;
  border: none;
  font-size: 26rpx;
  text-align: center;
}

.btn-action {
  padding: 12rpx 20rpx;
  font-size: 24rpx;
  color: #007AFF;
  background-color: rgba(0, 122, 255, 0.1);
  border-radius: 12rpx;
  min-height: auto;
  font-weight: 500;
  border: 1rpx solid rgba(0, 122, 255, 0.3);
}

.btn-action:active {
  transform: scale(0.96);
  background-color: rgba(0, 122, 255, 0.2);
}

.btn-action.add {
  color: #34C759;
  background-color: rgba(52, 199, 89, 0.1);
  border: 1rpx solid rgba(52, 199, 89, 0.3);
}

/* 历史菜单 */
.history-list {
  padding: 24rpx;
}

.history-day {
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 1rpx 3rpx rgba(0,0,0,0.02);
}

.history-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #e5e5ea;
}

.history-date {
  font-size: 34rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.btn-reuse {
  background-color: #000000;
  color: #ffffff;
  border-radius: 16rpx;
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  font-weight: 600;
  min-height: auto;
}

.btn-reuse:active {
  background-color: #333333;
  transform: scale(0.96);
}

.history-items {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.history-tag {
  display: inline-block;
  background: #F5F5F7;
  color: #1d1d1f;
  font-size: 28rpx;
  padding: 12rpx 20rpx;
  border-radius: 20rpx;
  border: 1rpx solid #e5e5ea;
}

.tag-price {
  color: #000000;
  font-weight: 600;
  font-family: ui-monospace, "SF Mono", monospace;
  margin-left: 8rpx;
}

/* 提示条 */
.tip-bar {
  background: #F5F5F7;
  color: #6e6e73;
  font-size: 26rpx;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #e5e5ea;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: var(--spacing-20) 0;
  color: var(--color-text-tertiary);
  font-size: var(--font-size-md);
}

/* 空状态提示 */
.empty-tip {
  text-align: center;
  padding: 80rpx 32rpx;
  color: #86868b;
  font-size: 28rpx;
}

.empty-inline {
  text-align: center;
  padding: 40rpx 24rpx;
  color: #86868b;
  font-size: 28rpx;
}
