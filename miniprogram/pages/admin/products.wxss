/* pages/admin/products.wxss */

.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

.header {
  background-color: #ffffff;
  padding: 32rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
  position: sticky;
  top: 0;
  z-index: 100;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.header-add {
  font-size: 28rpx;
  color: #ff6b35;
  padding: 8rpx 24rpx;
  border: 1rpx solid #ff6b35;
  border-radius: 12rpx;
}

.header-add:active {
  background-color: #ff6b35;
  color: #ffffff;
}

/* 产品列表 */
.product-list {
  padding: 24rpx 0 80rpx;
}

.product-item {
  background-color: #ffffff;
  border-radius: 16rpx;
  margin: 0 24rpx 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  border-left: 6rpx solid #ff6b35;
  transition: transform 0.2s;
}

.product-item:active {
  transform: translateY(-2rpx);
}

.product-info {
  flex: 1;
}

.product-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.product-meta {
  font-size: 28rpx;
  color: #666;
}

.product-meta .unit {
  color: #999;
}

.product-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  padding: 8rpx 24rpx;
  font-size: 26rpx;
  min-height: auto;
  border-radius: 12rpx;
}

.action-btn.edit {
  background-color: rgba(0, 183, 255, 0.1);
  color: #007BFF;
  border: 1rpx solid rgba(0, 123, 255, 0.3);
}

.action-btn.edit:active {
  background-color: rgba(0, 123, 255, 0.2);
}

.action-btn.delete {
  background-color: rgba(255, 107, 107, 0.1);
  color: #dc3545;
  border: 1rpx solid rgba(220, 53, 69, 0.3);
}

.action-btn.delete:active {
  background-color: rgba(220, 53, 69, 0.2);
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0,0,0,0.5);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.modal-box {
  background-color: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 64rpx 48rpx;
  width: 100%;
  max-height: 80vh;
  overflow-y: auto;
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 48rpx;
  color: #333;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
  display: block;
}

.form-input {
  width: 100%;
  padding: 24rpx;
}

.modal-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 48rpx;
}

.modal-actions .btn {
  flex: 1;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 32rpx;
  text-align: center;
  color: #999;
}

.empty-state-icon {
  font-size: 80rpx;
  margin-bottom: 32rpx;
  opacity: 0.3;
}

.empty-state-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: #666;
}

.empty-state-description {
  font-size: 28rpx;
  color: #999;
}
