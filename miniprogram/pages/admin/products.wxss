/* pages/admin/products.wxss */

.container {
  min-height: 100vh;
  background-color: #F5F5F7;
  padding-bottom: 60rpx;
}

.header {
  background-color: #ffffff;
  padding: 32rpx 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  position: sticky;
  top: 0;
  z-index: 100;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.header-content {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.header-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1d1d1f;
  letter-spacing: -0.5rpx;
}

.header-subtitle {
  font-size: 22rpx;
  color: #86868b;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}

.header-add {
  font-size: 26rpx;
  color: #ffffff;
  padding: 16rpx 28rpx;
  background-color: #000000;
  border-radius: 20rpx;
  font-weight: 600;
}

.header-add:active {
  background-color: #333333;
  transform: scale(0.96);
}

/* 产品列表 */
.product-list {
  padding: 24rpx;
}

.product-item {
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 1rpx 3rpx rgba(0,0,0,0.02);
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: transform 0.2s;
}

.product-item:active {
  transform: scale(0.98);
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.product-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.product-meta {
  font-size: 26rpx;
  color: #86868b;
  font-family: ui-monospace, "SF Mono", monospace;
}

.product-meta .unit {
  color: #aeaeb2;
}

.product-actions {
  display: flex;
  gap: 12rpx;
}

.action-btn {
  padding: 12rpx 20rpx;
  font-size: 24rpx;
  min-height: auto;
  border-radius: 12rpx;
}

.action-btn.edit {
  background-color: rgba(0, 122, 255, 0.1);
  color: #007AFF;
  border: 1rpx solid rgba(0, 122, 255, 0.3);
}

.action-btn.edit:active {
  background-color: rgba(0, 122, 255, 0.2);
  transform: scale(0.96);
}

.action-btn.delete {
  background-color: rgba(255, 59, 48, 0.1);
  color: #FF3B30;
  border: 1rpx solid rgba(255, 59, 48, 0.3);
}

.action-btn.delete:active {
  background-color: rgba(255, 59, 48, 0.2);
  transform: scale(0.96);
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0,0,0,0.5);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.modal-box {
  background-color: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 64rpx 48rpx;
  width: 100%;
  max-height: 80vh;
  overflow-y: auto;
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 48rpx;
  color: #333;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
  display: block;
}

.form-input {
  width: 100%;
  padding: 24rpx;
}

.modal-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 48rpx;
}

.modal-actions .btn {
  flex: 1;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 32rpx;
  text-align: center;
  color: #999;
}

.empty-state-icon {
  font-size: 80rpx;
  margin-bottom: 32rpx;
  opacity: 0.3;
}

.empty-state-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: #666;
}

.empty-state-description {
  font-size: 28rpx;
  color: #999;
}
