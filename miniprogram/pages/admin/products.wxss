/* pages/admin/products.wxss - 基于设计系统 */

.container {
  min-height: 100vh;
  background-color: var(--color-bg-page);
  padding-bottom: var(--spacing-8);
}

.header {
  background-color: var(--color-bg-card);
  padding: var(--spacing-5) var(--spacing-4);
  box-shadow: var(--shadow-sm);
  position: sticky;
  top: 0;
  z-index: 100;
}

.header-title {
  font-size: var(--font-size-xl);
  font-weight: var(--font-weight-bold);
  color: var(--color-text-primary);
}

.header-add {
  font-size: var(--font-size-base);
  color: var(--color-primary);
  padding: var(--spacing-2) var(--spacing-4);
  border: 1rpx solid var(--color-primary);
  border-radius: var(--radius-md);
  transition: all var(--transition-fast);
}

.header-add:active {
  background-color: var(--color-primary);
  color: var(--color-white);
}

/* 产品列表 */
.product-list {
  padding: var(--spacing-4) 0 var(--spacing-12);
}

.product-item {
  background-color: var(--color-bg-card);
  border-radius: var(--radius-lg);
  margin: 0 var(--spacing-4) var(--spacing-3);
  padding: var(--spacing-4);
  box-shadow: var(--shadow-sm);
  border-left: 6rpx solid var(--color-primary);
  transition: transform var(--transition-fast);
}

.product-item:active {
  transform: translateY(-2rpx);
}

.product-info {
  flex: 1;
}

.product-name {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-2);
}

.product-meta {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
}

.product-meta .unit {
  color: var(--color-text-tertiary);
}

.product-actions {
  display: flex;
  gap: var(--spacing-2);
}

.action-btn {
  padding: var(--spacing-1) var(--spacing-3);
  font-size: var(--font-size-sm);
  min-height: auto;
  border-radius: var(--radius-md);
}

.action-btn.edit {
  background-color: rgba(0, 183, 255, 0.1);
  color: #007BFF;
  border: 1rpx solid rgba(0, 123, 255, 0.3);
}

.action-btn.edit:active {
  background-color: rgba(0, 123, 255, 0.2);
}

.action-btn.delete {
  background-color: rgba(255, 107, 107, 0.1);
  color: var(--color-error);
  border: 1rpx solid rgba(220, 53, 69, 0.3);
}

.action-btn.delete:active {
  background-color: rgba(220, 53, 69, 0.2);
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: var(--color-bg-overlay);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
  animation: fadeIn var(--transition-normal);
}

.modal-box {
  background-color: var(--color-bg-card);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  padding: var(--spacing-8) var(--spacing-6) env(safe-area-inset-bottom);
  width: 100%;
  max-height: 80vh;
  overflow-y: auto;
  animation: slideUp var(--transition-normal);
}

.modal-title {
  font-size: var(--font-size-xl);
  font-weight: var(--font-weight-bold);
  text-align: center;
  margin-bottom: var(--spacing-6);
  color: var(--color-text-primary);
}

.form-item {
  margin-bottom: var(--spacing-4);
}

.form-label {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  margin-bottom: var(--spacing-2);
  display: block;
}

.form-input {
  width: 100%;
  padding: var(--spacing-4);
}

.modal-actions {
  display: flex;
  gap: var(--spacing-3);
  margin-top: var(--spacing-6);
}

.modal-actions .btn {
  flex: 1;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-20) var(--spacing-4);
  text-align: center;
  color: var(--color-text-tertiary);
}

.empty-state-icon {
  font-size: 80rpx;
  margin-bottom: var(--spacing-4);
  opacity: 0.3;
}

.empty-state-title {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  margin-bottom: var(--spacing-2);
  color: var(--color-text-secondary);
}

.empty-state-description {
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
}
