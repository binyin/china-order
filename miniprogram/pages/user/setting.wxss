/* pages/user/setting.wxss */
.setting-container {
  padding: 32rpx;
}

.section-title {
  font-size: 28rpx;
  color: #8e8e93;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.user-info-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  display: flex;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.avatar-btn-setting {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #f5f5f7;
  padding: 0;
  flex-shrink: 0;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-placeholder-setting {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.info-group {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.info-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.info-label {
  font-size: 28rpx;
  color: #666;
  width: 80rpx;
  flex-shrink: 0;
}

.info-input {
  flex: 1;
  font-size: 30rpx;
  color: #333;
  border-bottom: 1rpx solid #eee;
  padding: 8rpx 0;
}

.btn-save {
  background: linear-gradient(135deg, #ff9500 0%, #ff6a00 100%);
  color: #fff;
  border-radius: 16rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

.setting-item:first-child {
  border-top-left-radius: 12rpx;
  border-top-right-radius: 12rpx;
}

.setting-item:last-child {
  border-bottom-left-radius: 12rpx;
  border-bottom-right-radius: 12rpx;
  border-bottom: none;
}

.setting-label {
  font-size: 30rpx;
  color: #333;
}

.setting-value {
  font-size: 30rpx;
  color: #666;
}

.setting-arrow {
  font-size: 36rpx;
  color: #ccc;
}

.dev-intro-box {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}

.dev-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
}

.dev-desc {
  font-size: 24rpx;
  color: #666;
}

.dev-promo {
  font-size: 22rpx;
  color: #ff9500;
  font-weight: 500;
}