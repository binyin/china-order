/* pages/user/index.wxss */
page {
  background-color: #f2f2f7;
  --apple-orange: #ff9500;
  --apple-blue: #007aff;
  --apple-gray: #8e8e93;
}

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* 顶部导航 */
.header {
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(20px);
  padding: 60rpx 40rpx 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #d1d1d6;
  z-index: 10;
}

.header-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #000;
}

.header-admin {
  font-size: 24rpx;
  color: var(--apple-blue);
  font-weight: 500;
}

/* 列表滚动区 */
.content-scroll {
  flex: 1;
  overflow-y: scroll;
}

.menu-list {
  padding: 20rpx 30rpx;
}

.menu-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.item-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  margin-right: 24rpx;
  background-color: #f5f5f5;
  flex-shrink: 0;
}

.item-name {
  font-size: 34rpx;
  font-weight: 500;
  display: block;
}

.item-left {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.item-price {
  font-size: 28rpx;
  font-weight: 500;
  color: #666;
  margin-top: 6rpx;
  display: block;
}

.item-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.counter-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 400;
  border-radius: 50%;
}

.counter-btn.plus {
  background: var(--apple-orange);
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(255,149,0,0.3);
}

.counter-btn.minus {
  background: #f2f2f7;
  color: var(--apple-orange);
}

.counter-num {
  min-width: 40rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #000;
}

/* 我的预定卡片 */
.submitted-section {
  padding: 20rpx 30rpx;
}

.section-title {
  font-size: 38rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
  padding-left: 10rpx;
}

.order-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.order-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.order-user {
  font-weight: 600;
  font-size: 30rpx;
}

.status-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.tag-pending { background: #fff9e6; color: #ff9500; }
.tag-completed { background: #f2fcf5; color: #34c759; }

.order-content {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.prod-item {
  display: flex;
  align-items: center;
  background: #f5f5f7;
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
  gap: 12rpx;
}

.prod-img {
  width: 60rpx;
  height: 60rpx;
  border-radius: 8rpx;
  background-color: #eee;
}

.prod-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.prod-name {
  font-size: 28rpx;
  color: #333;
}

.prod-qty {
  font-size: 26rpx;
  color: #666;
}

/* 底部浮动栏 */
.floating-bar {
  position: fixed;
  bottom: -200rpx;
  left: 0;
  right: 0;
  transition: bottom 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  padding: 30rpx 40rpx 60rpx;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20px);
  border-top: 1rpx solid #d1d1d6;
}

.floating-bar.active {
  bottom: 0;
}

.bar-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.bar-amount {
  font-size: 48rpx;
  font-weight: 700;
  display: block;
}

.bar-actions {
  display: flex;
  align-items: center;
  gap: 30rpx;
}

.bar-clear {
  color: var(--apple-gray);
  font-size: 28rpx;
}

.btn-primary-apple {
  background: var(--apple-orange);
  color: #fff;
  border-radius: 18rpx;
  padding: 20rpx 40rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1;
}

/* 弹窗设计 */
.apple-modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.apple-modal-box {
  background: #fff;
  width: 80%;
  border-radius: 30rpx;
  padding: 40rpx;
}

.apple-input {
  background: #f2f2f7;
  height: 90rpx;
  border-radius: 14rpx;
  padding: 0 20rpx;
  margin-top: 10rpx;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}

.modal-footer button {
  flex: 1;
  font-size: 30rpx;
  border-radius: 14rpx;
}

.btn-modal-confirm {
  background: var(--apple-orange);
  color: #fff;
}

.auth-wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
}

.auth-icon {
  font-size: 120rpx;
  margin-bottom: 40rpx;
}

.auth-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #000;
  margin-bottom: 20rpx;
}

.auth-desc {
  font-size: 28rpx;
  color: var(--apple-gray);
  margin-bottom: 60rpx;
}

.btn-auth {
  background: var(--apple-orange);
  color: #fff;
  border-radius: 20rpx;
  padding: 24rpx 80rpx;
  font-size: 32rpx;
  font-weight: 600;
}