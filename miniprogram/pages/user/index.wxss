  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.08);
}

.avatar-preview-large {
  width: 100%;
  height: 100%;
}

.avatar-placeholder-large {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.avatar-icon {
  font-size: 60rpx;
  margin-bottom: 8rpx;
}

.avatar-tip {
  font-size: 22rpx;
  color: #8e8e93;
}

.nickname-wrapper {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.input-label-center {
  font-size: 26rpx;
  color: #8e8e93;
  margin-bottom: 12rpx;
}

.nickname-input-center {
  width: 70%;
  background: #f2f2f7;
  height: 88rpx;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  text-align: center;
}

.input-group {
  margin-bottom: 24rpx;
}

.input-label {
  font-size: 26rpx;
  color: #8e8e93;
  margin-bottom: 12rpx;
  display: block;
}

.apple-input {
  background: #f2f2f7;
  height: 88rpx;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
}

.summary-list {
  background: #f9f9f9;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-top: 20rpx;
}

.summary-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eee;
}

.summary-item:last-child {
  border-bottom: none;
}

.summary-name {
  font-size: 28rpx;
  color: #333;
}

.summary-price {
  font-size: 28rpx;
  color: #666;
}

.summary-total {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #e5e5ea;
  font-size: 30rpx;
  font-weight: 600;
  color: #1c1c1e;
}

.total-price {
  font-size: 36rpx;
  font-weight: 700;
  color: #ff9500;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.modal-footer button {
  flex: 1;
  height: 88rpx;
  font-size: 32rpx;
  border-radius: 16rpx;
  line-height: 88rpx;
}

.btn-modal-cancel {
  background: #f2f2f7;
  color: #333;
}

.btn-modal-confirm {
  background: linear-gradient(135deg, #ff9500 0%, #ff6a00 100%);
  color: #fff;
  font-weight: 600;
  box-shadow: 0 6rpx 20rpx rgba(255,149,0,0.35);
}

.btn-modal-confirm.loading {
  opacity: 0.7;
}

/* 更多弹窗 */
.popup-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 100;
  display: flex;
  justify-content: flex-end;
  align-items: flex-start;
  padding-top: 160rpx;
  padding-right: 20rpx;
}

.popup-menu {
  background: #fff;
  border-radius: 20rpx;
  min-width: 280rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.15);
  overflow: hidden;
}

.popup-item {
  padding: 32rpx 40rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.popup-item:last-child {
  border-bottom: none;
}

.popup-text {
  font-size: 30rpx;
  color: #333;
}

/* 空状态 */
.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
  color: #999;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.empty-sub {
  font-size: 26rpx;
  margin-top: 12rpx;
}

