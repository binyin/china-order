.summary-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eee;
}

.summary-item:last-child {
  border-bottom: none;
}

.summary-name {
  font-size: 28rpx;
  color: #333;
}

.summary-price {
  font-size: 28rpx;
  color: #666;
}

.summary-total {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #e5e5ea;
  font-size: 30rpx;
  font-weight: 600;
  color: #1c1c1e;
}

.total-price {
  font-size: 36rpx;
  font-weight: 700;
  color: #ff9500;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.modal-footer button {
  flex: 1;
  height: 88rpx;
  font-size: 32rpx;
  border-radius: 16rpx;
  line-height: 88rpx;
}

.btn-modal-cancel {
  background: #f2f2f7;
  color: #333;
}

.btn-modal-confirm {
  background: linear-gradient(135deg, #ff9500 0%, #ff6a00 100%);
  color: #fff;
  font-weight: 600;
  box-shadow: 0 6rpx 20rpx rgba(255,149,0,0.35);
}

.btn-modal-confirm.loading {
  opacity: 0.7;
}

.auth-wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
}

.auth-icon {
  font-size: 120rpx;
  margin-bottom: 40rpx;
}

.auth-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #000;
  margin-bottom: 20rpx;
}

.auth-desc {
  font-size: 28rpx;
  color: var(--apple-gray);
  margin-bottom: 60rpx;
}

.btn-auth {
  background: var(--apple-orange);
  color: #fff;
  border-radius: 20rpx;
  padding: 24rpx 80rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 30rpx;
}

.nickname-input {
  background: #fff;
  border: 2rpx solid #eee;
  border-radius: 16rpx;
  padding: 20rpx 30rpx;
  font-size: 30rpx;
  margin-bottom: 30rpx;
  width: 80%;
}

.btn-confirm {
  background: #07c160;
}

.btn-confirm[disabled] {
  background: #ccc;
}

.profile-setup {
  display: none;
}

/* 更多弹窗 */
.popup-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 100;
  display: flex;
  justify-content: flex-end;
  align-items: flex-start;
  padding-top: 180rpx;
  padding-right: 20rpx;
}

.popup-menu {
  background: #fff;
  border-radius: 20rpx;
  min-width: 280rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.15);
  overflow: hidden;
}

.popup-item {
  padding: 32rpx 40rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.popup-item:last-child {
  border-bottom: none;
}

.popup-text {
  font-size: 30rpx;
  color: #333;
}