/* pages/user/index.wxss */
.container {
  min-height: 100vh;
  background: #f2f2f7;
  padding-bottom: 60rpx;
}

/* 顶部导航 */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  padding: 36rpx 32rpx 28rpx;
  border-bottom: 1rpx solid #e5e5ea;
}
.header-left { display: flex; align-items: center; }
.header-setting {
  font-size: 40rpx;
  padding: 8rpx 16rpx;
  font-weight: 300;
  color: #333;
}
.header-title { 
  flex: 1;
  text-align: center;
  font-size: 40rpx; 
  font-weight: 700; 
  color: #1d1d1f;
  letter-spacing: -0.5rpx;
}
.header-right { display: flex; align-items: center; gap: 16rpx; }
.header-profile { 
  font-size: 28rpx; 
  color: #1d1d1f; 
  padding: 10rpx 20rpx; 
  background: #f2f2f7; 
  border-radius: 24rpx;
  font-weight: 500;
}
.profile-name { font-weight: 600; }
.header-history {
  font-size: 26rpx; 
  color: #1d1d1f;
  padding: 10rpx 24rpx;
  background: #f2f2f7; 
  border-radius: 24rpx;
  font-weight: 500;
}
.header-admin {
  font-size: 26rpx; 
  color: #ff6b35;
  padding: 10rpx 24rpx;
  border: 2rpx solid #ff6b35; 
  border-radius: 24rpx;
  font-weight: 600;
}

/* 订单操作栏 - 苹果风 */
.order-bar {
  position: sticky;
  top: 0;
  z-index: 100;
  background: #fff;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 32rpx;
  border-top: 1rpx solid #e5e5ea;
}
.total-price {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}
.total-label {
  font-size: 28rpx;
  color: #8e8e93;
}
.total-amount {
  font-size: 48rpx;
  font-weight: 700;
  color: #ff9500;
  letter-spacing: -0.5rpx;
}
.order-actions {
  display: flex;
  gap: 12rpx;
}
.btn-cancel-all {
  background: #f2f2f7;
  color: #666;
  border: none;
  border-radius: 12rpx;
  font-size: 28rpx;
  padding: 16rpx 24rpx;
  line-height: 1.4;
  font-weight: 500;
}
.btn-submit {
  background: #ff9500;
  color: #fff;
  border: none;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 16rpx 32rpx;
  font-weight: 600;
}
.btn-submit:active {
  opacity: 0.85;
  transform: scale(0.98);
}

/* 菜单滚动 */
.menu-wrap { display: flex; flex-direction: column; height: 100vh; }
.menu-scroll { flex: 1; }
.menu-list { padding: 8rpx 0; }

/* 菜单项 - 苹果风 */
.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  margin: 8rpx 24rpx;
  background: #fff;
  border-radius: 12rpx;
  box-shadow: 0 1rpx 3rpx rgba(0,0,0,0.04);
}
.item-left {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}
.item-name {
  font-size: 34rpx;
  font-weight: 500;
  color: #1d1d1f;
}
.item-stock {
  font-size: 26rpx;
  color: #8e8e93;
}
.item-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.item-price {
  font-size: 32rpx;
  font-weight: 600;
  color: #ff9500;
  min-width: 80rpx;
  text-align: right;
}

/* 数量选择器 - 紧凑 */
.item-counter {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.counter-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 500;
  line-height: 1;
}
.counter-btn.plus {
  background: #ff9500;
  color: #fff;
}
.counter-btn.minus {
  background: #f2f2f7;
  color: #666;
}
.counter-num {
  font-size: 34rpx;
  font-weight: 600;
  min-width: 40rpx;
  text-align: center;
  color: #1d1d1f;
}

/* 已提交订单 */
.submitted-section { margin-top: 24rpx; }
.section-title { font-size: 32rpx; font-weight: bold; color: #555; padding: 16rpx 32rpx 0; }
.submitted-item.card {
  margin: 16rpx 24rpx; padding: 28rpx;
  background: #fff; border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  transition: opacity 0.3s;
}
.submitted-item.cancelled { opacity: 0.5; }
.submitted-header {
  display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx;
}
.submitted-name { font-size: 32rpx; font-weight: bold; }
.submitted-items { font-size: 28rpx; color: #666; margin-bottom: 16rpx; line-height: 1.8; }
.submitted-footer { display: flex; justify-content: space-between; align-items: center; }
.submitted-price { font-size: 34rpx; color: #ff6b35; font-weight: bold; }
.btn-cancel-order {
  background: #fff; color: #e74c3c; border: 1rpx solid #e74c3c;
  border-radius: 8rpx; font-size: 24rpx; padding: 6rpx 20rpx; line-height: 1.4;
}

/* 状态标签 */
.tag-pending { background: #fff3cd; color: #856404; padding: 4rpx 16rpx; border-radius: 20rpx; font-size: 24rpx; }
.tag-completed { background: #d4edda; color: #155724; padding: 4rpx 16rpx; border-radius: 20rpx; font-size: 24rpx; }
.tag-cancelled { background: #f8d7da; color: #721c24; padding: 4rpx 16rpx; border-radius: 20rpx; font-size: 24rpx; }

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal-box {
  background: #fff;
  width: 90%;
  max-height: 80%;
  border-radius: 24rpx;
  overflow: hidden;
}
.modal-scroll {
  max-height: 80vh;
}
.modal-content {
  padding: 40rpx 32rpx 60rpx;
}
.modal-title {
  font-size: 38rpx;
  font-weight: bold;
  margin-bottom: 28rpx;
  text-align: center;
}

/* 昵称区 */
.nickname-row {
  width: 100%;
  margin-bottom: 32rpx;
}
.nickname-input-wrap {
  width: 100%;
}
.form-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 12rpx;
  display: block;
}
.modal-input.nickname-input {
  width: 100%;
  min-height: 88rpx;
  padding: 24rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 16rpx;
  font-size: 32rpx;
  line-height: 1.4;
  box-sizing: border-box;
  background: #fff;
}
.modal-input.nickname-input:focus {
  border-color: #ff6b35;
  background: #fff;
}
.placeholder {
  color: #bbb;
  font-size: 32rpx;
}
/* 确保弹窗内容区域有足够空间 */
.modal-box {
  max-height: 90vh;
  overflow-y: auto;
  padding: 40rpx 32rpx 80rpx;
  box-sizing: border-box;
}

/* 订单汇总 */
.modal-summary {
  background: #f9f9f9; border-radius: 12rpx;
  padding: 20rpx 24rpx; margin-bottom: 28rpx;
}
.summary-row {
  display: flex; justify-content: space-between;
  font-size: 28rpx; color: #555; padding: 6rpx 0;
}
.summary-total {
  font-size: 32rpx; font-weight: bold; color: #ff6b35;
  margin-top: 12rpx; text-align: right;
}
.modal-actions { display: flex; gap: 20rpx; }
.modal-actions button {
  flex: 1; border-radius: 12rpx; font-size: 32rpx; padding: 22rpx 0; line-height: 1.4;
}
.btn-primary { background: #ff6b35; color: #fff; border: none; }
.btn-secondary { background: #fff; color: #ff6b35; border: 2rpx solid #ff6b35; }

/* 空状态 */
.empty-tip { text-align: center; color: #999; font-size: 30rpx; padding: 80rpx 0; }
