/* pages/user/index.wxss */
page {
  background-color: #f2f2f7;
  --apple-orange: #ff9500;
  --apple-blue: #007aff;
  --apple-gray: #8e8e93;
}

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* 顶部导航栏 - iOS风格 */
.top-bar {
  background: #fff;
  padding: 60rpx 40rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.02);
  position: relative;
  z-index: 10;
}

/* 左侧日期触发器 */
.date-trigger {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.date-trigger-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #000;
}

.date-trigger-icon {
  font-size: 32rpx;
  color: #999;
  transition: transform 0.2s ease;
}

.date-trigger-icon.expanded {
  transform: rotate(90deg);
}

/* 右侧设置按钮 */
.settings-btn {
  display: flex;
  align-items: center;
}

.settings-circle {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 1rpx solid #e5e5ea;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.settings-icon {
  font-size: 28rpx;
  color: #666;
}

/* 日期选择器展开区域 */
.date-picker-wrap {
  background: #fff;
  height: 0;
  overflow: hidden;
  transition: height 0.25s ease;
}

.date-picker-wrap.show {
  height: 140rpx;
}

.date-picker {
  height: 140rpx;
  white-space: nowrap;
}

.date-picker-inner {
  display: inline-flex;
  padding: 0 30rpx;
  gap: 20rpx;
}

.date-pick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 80rpx;
  height: 120rpx;
  border-radius: 16rpx;
  padding: 10rpx 16rpx;
}

.date-pick-item.active {
  background: #000;
}

.date-pick-week {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.date-pick-day {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.date-pick-item.active .date-pick-week,
.date-pick-item.active .date-pick-day {
  color: #fff;
}

/* 内容滚动区 */
.content-scroll {
  flex: 1;
  overflow-y: scroll;
}

/* 列表样式 */
.menu-list {
  padding: 20rpx 30rpx;
}

.menu-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.item-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  margin-right: 24rpx;
  background-color: #f5f5f5;
  flex-shrink: 0;
}

.item-img-placeholder {
  background: linear-gradient(135deg, #f5f5f5 25%, #e8e8e8 50%, #f5f5f5 75%);
  background-size: 200% 200%;
  animation: shimmer 1.5s infinite;
}

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

.item-name {
  font-size: 34rpx;
  font-weight: 500;
  display: block;
}

.item-left {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.item-price {
  font-size: 28rpx;
  font-weight: 500;
  color: #666;
  margin-top: 6rpx;
  display: block;
}

.item-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.counter-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 400;
  border-radius: 50%;
}

.counter-btn.plus {
  background: var(--apple-orange);
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(255,149,0,0.3);
}

.counter-btn.minus {
  background: #f2f2f7;
  color: var(--apple-orange);
}

.counter-num {
  min-width: 40rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #000;
}

.counter-btn.disabled,
.counter-num.disabled {
  opacity: 0.4;
}

/* 我的预定 */
.submitted-section {
  padding: 20rpx 30rpx;
}

.section-title {
  font-size: 38rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
  padding-left: 10rpx;
}

.order-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.order-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.order-user {
  font-weight: 600;
  font-size: 30rpx;
}

.status-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.tag-pending { background: #fff9e6; color: #ff9500; }
.tag-completed { background: #f2f2f5; color: #34c759; }

.order-content {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.prod-item {
  display: flex;
  align-items: center;
  background: #f5f5f7;
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
  gap: 12rpx;
}

.prod-img {
  width: 60rpx;
  height: 60rpx;
  border-radius: 8rpx;
  background-color: #eee;
}

.prod-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.prod-name {
  font-size: 28rpx;
  color: #333;
}

.prod-qty {
  font-size: 26rpx;
  color: #666;
}

/* 底部浮动栏 */
.floating-bar {
  position: fixed;
  bottom: -200rpx;
  left: 0;
  right: 0;
  transition: bottom 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  padding: 30rpx 40rpx 60rpx;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20px);
  border-top: 1rpx solid #d1d1d6;
}

.floating-bar.active {
  bottom: 0;
}

.bar-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.bar-amount {
  font-size: 48rpx;
  font-weight: 700;
  display: block;
}

.bar-actions {
  display: flex;
  align-items: center;
  gap: 30rpx;
}

.bar-clear {
  color: var(--apple-gray);
  font-size: 28rpx;
}

.btn-primary-apple {
  background: var(--apple-orange);
  color: #fff;
  border-radius: 18rpx;
  padding: 20rpx 40rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1;
}

/* 弹窗设计 */
.apple-modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  backdrop-filter: blur(5px);
}

.apple-modal-box {
  background: #fff;
  width: 86%;
  max-width: 640rpx;
  border-radius: 32rpx;
  padding: 48rpx 40rpx 36rpx;
  box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.15);
}

.modal-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.modal-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1c1c1e;
  display: block;
}

.modal-subtitle {
  font-size: 26rpx;
  color: #8e8e93;
  margin-top: 12rpx;
  display: block;
}

.modal-body {
  margin-bottom: 32rpx;
}

.auth-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

.avatar-btn-large {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  overflow: hidden;
  background: linear-gradient(135deg, #f5f5f7 0%, #e8e8ed 100%);
  border: 4rpx solid #fff;
  padding: 0;
