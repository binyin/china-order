<view class="container">
  <view class="top-bar">
    <view class="date-trigger" bindtap="toggleDatePicker">
      <text class="date-trigger-text">{{formatDate}}</text>
      <text class="date-trigger-icon {{showDatePicker ? 'expanded' : ''}}">›</text>
    </view>
    <view class="settings-btn" bindtap="toggleMorePopup">
      <view class="settings-circle">
        <text class="settings-icon">⚙</text>
      </view>
    </view>
  </view>

  <view class="date-picker-wrap {{showDatePicker ? 'show' : ''}}">
    <scroll-view class="date-picker" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="date-picker-inner">
        <view wx:for="{{dateList}}" wx:key="date" class="date-pick-item {{item.date === selectedDate ? 'active' : ''}}" bindtap="onDateSelect" data-index="{{index}}">
          <text class="date-pick-week">{{item.label}}</text>
          <text class="date-pick-day">{{item.day}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <view wx:if="{{showMorePopup}}" class="popup-mask" bindtap="closeMorePopup">
    <view class="popup-menu">
      <view class="popup-item" bindtap="goSetting">
        <text class="popup-text">设置</text>
      </view>
      <view class="popup-item" bindtap="goAdmin">
        <text class="popup-text">店长登录</text>
      </view>
    </view>
  </view>

  <scroll-view scroll-y class="content-scroll">
    <view wx:if="{{menuList.length === 0}}" class="empty-tip">
      <view class="empty-icon">🍞</view>
      <view>暂无预定品种</view>
      <view class="empty-sub">该日尚未发布菜单</view>
    </view>

    <view class="menu-list">
      <view class="menu-item" wx:for="{{menuList}}" wx:key="_id">
        <image wx:if="{{item.image_url}}" class="item-img" src="{{item.image_url}}" mode="aspectFill" bindtap="previewImage" data-url="{{item.image_url}}" binderror="onImageError" data-index="{{index}}" />
        <view wx:if="{{!item.image_url}}" class="item-img item-img-placeholder" />
        <view class="item-left">
          <text class="item-name">{{item.name}}</text>
          <view class="item-tags" wx:if="{{item.tags && item.tags.length > 0}}">
            <text class="tag-pill" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
          </view>
          <text class="item-price" wx:if="{{orderMode === 'order'}}">¥{{item.price}}</text>
        </view>
        <view class="item-right" wx:if="{{orderMode === 'order'}}">
          <view class="counter-btn minus {{item.disabled ? 'disabled' : ''}}" bindtap="decrease" data-index="{{index}}">－</view>
          <text class="counter-num {{item.disabled ? 'disabled' : ''}}" bindtap="editQty" data-index="{{index}}">{{item.qty || 0}}</text>
          <view class="counter-btn plus {{item.disabled ? 'disabled' : ''}}" bindtap="increase" data-index="{{index}}">＋</view>
        </view>
        <view class="item-right" wx:if="{{orderMode === 'browse'}}">
          <view class="contact-btn" bindtap="increase" data-index="{{index}}">联系我</view>
        </view>
      </view>
    </view>

    <view wx:if="{{submittedOrders.length > 0 && orderMode === 'order'}}" class="submitted-section">
      <view class="section-title">我的预定</view>
      <view class="order-card {{item.status === 'cancelled' ? 'cancelled' : ''}}" wx:for="{{submittedOrders}}" wx:key="_id">
        <view class="order-header">
          <text class="order-name">{{item.customer_nickname || item.customer_name}}</text>
          <text class="status-tag tag-{{item.status}}">{{statusText[item.status]}}</text>
        </view>
        <view class="order-content">
          <view class="prod-item" wx:for="{{item.items}}" wx:for-item="prod" wx:key="product_id">
            <image class="prod-img" src="{{prod.image_url}}" mode="aspectFill" wx:if="{{prod.image_url}}" />
            <view class="prod-info">
              <text class="prod-name">{{prod.name}}</text>
              <text class="prod-qty">× {{prod.num}}</text>
            </view>
          </view>
        </view>
        <view class="order-footer">
          <text class="order-price">¥{{item.total_price}}</text>
          <button class="btn-cancel-small" bindtap="cancelOrder" data-id="{{item._id}}" wx:if="{{item.status === 'pending'}}">取消预定</button>
          <button class="btn-delete-small" bindtap="deleteOrder" data-id="{{item._id}}" wx:if="{{item.status !== 'pending'}}">删除</button>
        </view>
      </view>
    </view>
    
    <view style="height: 200rpx;"></view>
  </scroll-view>

  <view class="floating-bar {{hasSelected ? 'active' : ''}}" wx:if="{{orderMode === 'order'}}">
    <view class="bar-content">
      <view class="price-info">
        <text class="bar-label">合计</text>
        <text class="bar-amount">¥{{totalPrice}}</text>
      </view>
      <view class="bar-actions">
        <text class="bar-clear" bindtap="cancelAllItems">清空</text>
        <button class="btn-primary-apple" bindtap="submitOrder">提交</button>
      </view>
    </view>
  </view>
  <view class="floating-bar active" wx:if="{{orderMode === 'browse'}}">
    <view class="bar-content">
      <view class="bar-actions" style="justify-content: center; width: 100%;">
        <button class="btn-primary-apple" bindtap="setData({showContactModal:true})">联系我</button>
      </view>
    </view>
  </view>
</view>

<view class="qty-modal-mask" wx:if="{{showQtyModal}}" bindtap="closeQtyModal">
  <view class="qty-modal-box" catchtap>
    <text class="qty-modal-title">输入数量</text>
    <input class="qty-modal-input" type="number" focus="{{true}}" value="{{editQtyValue}}" bindinput="onQtyInput" placeholder="1-50" maxlength="2" />
    <view class="qty-modal-btns">
      <button class="qty-btn-cancel" bindtap="closeQtyModal">取消</button>
      <button class="qty-btn-confirm" bindtap="confirmQtyEdit">确定</button>
    </view>
  </view>
</view>

<view class="apple-modal-mask" wx:if="{{showModal}}" bindtap="closeModal">
  <view class="apple-modal-box" catchtap>
    <view class="modal-header">
      <text class="modal-title">{{orderSummary.length > 0 ? '确认' : '欢迎使用'}}</text>
      <text class="modal-subtitle" wx:if="{{!hasProfile}}">请先完善您的取货信息</text>
    </view>
    <view class="modal-body">
      <view wx:if="{{!hasProfile}}" class="auth-section">
        <button class="avatar-btn-large" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <image wx:if="{{tempAvatarUrl}}" class="avatar-preview-large" src="{{tempAvatarUrl}}" mode="aspectFill" />
          <view wx:else class="avatar-placeholder-large">
            <text class="avatar-icon">👤</text>
            <text class="avatar-tip">点击选择头像</text>
          </view>
        </button>
        <view class="nickname-wrapper">
          <text class="input-label-center">姓名</text>
          <input class="nickname-input-center" type="nickname" placeholder="请输入您的称呼" value="{{tempNickname}}" bindinput="onNicknameInput" />
        </view>
      </view>
      
      <view wx:if="{{orderSummary.length > 0}}">
        <view class="input-group">
          <text class="input-label">电话</text>
          <input class="apple-input" type="number" placeholder="请输入手机号(选填)" value="{{customerPhone}}" bindinput="onPhoneInput" />
        </view>
        <view class="summary-list">
          <view class="summary-item" wx:for="{{orderSummary}}" wx:key="name">
            <text class="summary-name">{{item.name}} x{{item.qty}}</text>
            <text class="summary-price">¥{{item.subtotal}}</text>
          </view>
          <view class="summary-total">
            <text>合计</text>
            <text class="total-price">¥{{totalPrice}}</text>
          </view>
        </view>
      </view>
    </view>
    <view class="modal-footer">
      <button class="btn-modal-cancel" bindtap="closeModal">取消</button>
      <button class="btn-modal-confirm {{submitting ? 'loading' : ''}}" bindtap="confirmOrder" loading="{{submitting}}">
        {{submitting ? '提交中...' : (orderSummary.length > 0 ? '确认下单' : '保存信息')}}
      </button>
    </view>
  </view>
</view>

<view class="apple-modal-mask" wx:if="{{showContactModal}}" bindtap="closeContactModal">
  <view class="apple-modal-box" catchtap>
    <view class="modal-header">
      <text class="modal-title">联系我们</text>
    </view>
    <view class="modal-body">
      <view class="contact-phone-wrap">
        <text class="contact-label">电话</text>
        <text class="contact-phone">{{contactPhone}}</text>
      </view>
    </view>
    <view class="modal-footer">
      <button class="btn-modal-cancel" bindtap="closeContactModal">关闭</button>
      <button class="btn-modal-confirm" bindtap="makeCall">拨打</button>
    </view>
  </view>
</view>