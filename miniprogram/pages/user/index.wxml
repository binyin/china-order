<view class="container">
  <block wx:if="{{!loading}}">
    <view class="header">
    <view class="header-left">
      <view class="header-setting" bindtap="goSetting">☰</view>
    </view>
    <view class="header-title">{{dateTime || '馒头预定'}}</view>
    <view class="header-right">
      <view class="header-admin" bindtap="goAdmin">店主入口</view>
    </view>
  </view>

  <scroll-view scroll-y class="content-scroll">
    <view wx:if="{{menuList.length === 0}}" class="empty-tip">
      <view class="empty-icon">🍞</view>
      <view>今日暂无预定品种</view>
      <view class="empty-sub">请等待店主发布今日菜单</view>
    </view>

    <view class="menu-list">
      <view class="menu-item" wx:for="{{menuList}}" wx:key="_id">
        <image wx:if="{{item.image_url}}" class="item-img" src="{{item.image_url}}" mode="aspectFill" bindtap="previewImage" data-url="{{item.image_url}}" binderror="onImageError" data-index="{{index}}" />
        <view wx:if="{{!item.image_url}}" class="item-img item-img-placeholder" />
        <view class="item-left">
          <text class="item-name">{{item.name}}</text>
          <text class="item-price">¥{{item.price}}</text>
        </view>
        <view class="item-right">
          <view class="counter-btn minus {{item.disabled ? 'disabled' : ''}}" bindtap="decrease" data-index="{{index}}">－</view>
          <text class="counter-num {{item.disabled ? 'disabled' : ''}}" bindtap="editQty" data-index="{{index}}">{{item.qty || 0}}</text>
          <view class="counter-btn plus {{item.disabled ? 'disabled' : ''}}" bindtap="increase" data-index="{{index}}">＋</view>
        </view>
      </view>
    </view>

    <view wx:if="{{submittedOrders.length > 0}}" class="submitted-section">
      <view class="section-title">我的预定</view>
      <view class="order-card {{item.status === 'cancelled' ? 'cancelled' : ''}}" wx:for="{{submittedOrders}}" wx:key="_id">
        <view class="order-header">
          <text class="order-user">{{item.customer_name}}</text>
          <text class="status-tag tag-{{item.status}}">{{statusText[item.status]}}</text>
        </view>
        <view class="order-content">
          <view class="prod-item" wx:for="{{item.items}}" wx:for-item="prod" wx:key="product_id">
            <image class="prod-img" src="{{prod.image_url}}" mode="aspectFill" wx:if="{{prod.image_url}}" />
            <view class="prod-info">
              <text class="prod-name">{{prod.name}}</text>
              <text class="prod-qty">× {{prod.num}}</text>
            </view>
          </view>
        </view>
        <view class="order-footer">
          <text class="order-price">¥{{item.total_price}}</text>
          <button class="btn-cancel-small" bindtap="cancelOrder" data-id="{{item._id}}" wx:if="{{item.status === 'pending'}}">取消预定</button>
        </view>
      </view>
    </view>
    
    <view style="height: 200rpx;"></view>
  </scroll-view>

  <view class="floating-bar {{hasSelected ? 'active' : ''}}">
    <view class="bar-content">
      <view class="price-info">
        <text class="bar-label">合计</text>
        <text class="bar-amount">¥{{totalPrice}}</text>
      </view>
      <view class="bar-actions">
        <text class="bar-clear" bindtap="cancelAllItems">清空</text>
        <button class="btn-primary-apple" bindtap="submitOrder">提交订单</button>
      </view>
    </view>
  </view>
  </block>
</view>

<view class="apple-modal-mask" wx:if="{{showModal}}" bindtap="closeModal">
  <view class="apple-modal-box" catchtap>
    <view class="modal-header">
      <text class="modal-title">{{orderSummary.length > 0 ? '确认订单' : '欢迎使用'}}</text>
      <text class="modal-subtitle" wx:if="{{!hasProfile}}">请先完善您的取货信息</text>
    </view>
    <view class="modal-body">
      <!-- 授权区域 -->
      <view wx:if="{{!hasProfile}}" class="auth-section">
        <button class="avatar-btn-large" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <image wx:if="{{tempAvatarUrl}}" class="avatar-preview-large" src="{{tempAvatarUrl}}" mode="aspectFill" />
          <view wx:else class="avatar-placeholder-large">
            <text class="avatar-icon">👤</text>
            <text class="avatar-tip">点击选择头像</text>
          </view>
        </button>
        <view class="nickname-wrapper">
          <text class="input-label-center">昵称</text>
          <input class="nickname-input-center" type="nickname" placeholder="请输入昵称" value="{{tempNickname}}" bindinput="onNicknameInput" />
        </view>
      </view>
      
      <!-- 订单确认区域 -->
      <view wx:if="{{orderSummary.length > 0}}">
        <view class="input-group">
          <text class="input-label">取货人姓名</text>
          <input class="apple-input" placeholder="请输入姓名" value="{{customerName}}" bindinput="onNameInput" />
        </view>
        <view class="summary-list">
          <view class="summary-item" wx:for="{{orderSummary}}" wx:key="name">
            <text class="summary-name">{{item.name}} x{{item.qty}}</text>
            <text class="summary-price">¥{{item.subtotal}}</text>
          </view>
          <view class="summary-total">
            <text>合计</text>
            <text class="total-price">¥{{totalPrice}}</text>
          </view>
        </view>
      </view>
    </view>
    <view class="modal-footer">
      <button class="btn-modal-cancel" bindtap="closeModal">取消</button>
      <button class="btn-modal-confirm {{submitting ? 'loading' : ''}}" bindtap="confirmOrder" loading="{{submitting}}">
        {{submitting ? '提交中...' : (orderSummary.length > 0 ? '确认下单' : '保存信息')}}
      </button>
    </view>
  </view>
</view>