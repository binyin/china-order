/* app.wxss - 全局样式 极简大字风格 */
page {
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  background-color: #f5f5f5;
  color: #333;
}

/* 通用按钮 */
.btn-primary {
  background: #ff6b35;
  color: #fff;
  border: none;
  border-radius: 12rpx;
  font-size: 32rpx;
  padding: 20rpx 0;
  width: 100%;
}

.btn-secondary {
  background: #fff;
  color: #ff6b35;
  border: 2rpx solid #ff6b35;
  border-radius: 12rpx;
  font-size: 32rpx;
  padding: 20rpx 0;
  width: 100%;
}

.btn-danger {
  background: #e74c3c;
  color: #fff;
  border: none;
  border-radius: 12rpx;
  font-size: 32rpx;
  padding: 20rpx 0;
  width: 100%;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 16rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

/* 页面标题 */
.page-title {
  font-size: 40rpx;
  font-weight: bold;
  padding: 32rpx 24rpx 16rpx;
  color: #222;
}

/* 标签 */
.tag-pending { background: #fff3cd; color: #856404; padding: 4rpx 16rpx; border-radius: 20rpx; font-size: 24rpx; }
.tag-completed { background: #d4edda; color: #155724; padding: 4rpx 16rpx; border-radius: 20rpx; font-size: 24rpx; }
.tag-cancelled { background: #f8d7da; color: #721c24; padding: 4rpx 16rpx; border-radius: 20rpx; font-size: 24rpx; }

/* 空状态 */
.empty-tip {
  text-align: center;
  color: #999;
  font-size: 30rpx;
  padding: 80rpx 0;
}
