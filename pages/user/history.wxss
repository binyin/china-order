/* pages/user/history.wxss */
.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

.header {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.header-back {
  font-size: 32rpx;
  color: #ff6b35;
  margin-right: 16rpx;
  padding: 8rpx 16rpx;
}
.header-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #222;
}

/* 1层：每日卡片 */
.daily-list { padding: 8rpx 0; }
.daily-card.card {
  margin: 12rpx 24rpx;
  padding: 24rpx 28rpx;
}
.daily-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.daily-date {
  font-size: 34rpx;
  font-weight: bold;
  color: #222;
}
.daily-revenue {
  font-size: 36rpx;
  font-weight: bold;
  color: #ff6b35;
}
.daily-products {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.daily-stats {
  display: flex;
  gap: 12rpx;
}
.stat-badge {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
}
.stat-badge.pending {
  background: #fff3cd;
  color: #856404;
}
.stat-badge.completed {
  background: #d4edda;
  color: #155724;
}
.stat-badge.cancelled {
  background: #f8d7da;
  color: #721c24;
}

/* 2层：订单列表 */
.order-list { padding: 8rpx 0; }
.order-card.card {
  margin: 12rpx 24rpx;
  padding: 20rpx 24rpx;
  transition: opacity 0.3s;
}
.order-card.cancelled {
  opacity: 0.5;
}
.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.order-time {
  font-size: 24rpx;
  color: #aaa;
}
.order-items {
  margin-bottom: 12rpx;
  line-height: 1.8;
}
.order-item-tag {
  display: inline-block;
  background: #f5f5f5;
  color: #555;
  font-size: 26rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  margin: 4rpx 6rpx 4rpx 0;
}
.order-footer {
  display: flex;
  justify-content: flex-end;
}
.order-price {
  font-size: 34rpx;
  font-weight: bold;
  color: #ff6b35;
}

/* 状态标签 */
.tag-pending { background: #fff3cd; color: #856404; padding: 4rpx 16rpx; border-radius: 20rpx; font-size: 24rpx; }
.tag-completed { background: #d4edda; color: #155724; padding: 4rpx 16rpx; border-radius: 20rpx; font-size: 24rpx; }
.tag-cancelled { background: #f8d7da; color: #721c24; padding: 4rpx 16rpx; border-radius: 20rpx; font-size: 24rpx; }

.empty-tip { text-align: center; color: #999; font-size: 30rpx; padding: 80rpx 0; }
