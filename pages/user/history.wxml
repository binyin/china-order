<!--pages/user/history.wxml-->
<view class="container">
  <view class="header">
    <view class="header-back" wx:if="{{showDetail}}" bindtap="backToList">← 返回</view>
    <view class="header-title">{{showDetail ? detailDate : '我的订单'}}</view>
  </view>

  <view wx:if="{{loading}}" class="empty-tip">加载中...</view>

  <!-- 1层：每日经营概况 -->
  <view wx:elif="{{!showDetail}}">
    <view wx:if="{{dailyList.length === 0}}" class="empty-tip">暂无订单记录</view>
    <view class="daily-list">
      <view class="daily-card card" wx:for="{{dailyList}}" wx:key="date" bindtap="openDetail" data-index="{{index}}">
        <view class="daily-header">
          <view class="daily-date">{{item.date}}</view>
          <view class="daily-revenue">¥{{item.totalRevenue}}</view>
        </view>
        <view class="daily-products">{{item.productNames}}</view>
        <view class="daily-stats">
          <text class="stat-badge pending">{{item.pendingCount}} 待取</text>
          <text class="stat-badge completed">{{item.completedCount}} 已取</text>
          <text wx:if="{{item.cancelledCount > 0}}" class="stat-badge cancelled">{{item.cancelledCount}} 已取消</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 2层：订单列表 -->
  <view wx:elif="{{showDetail}}">
    <view wx:if="{{detailOrders.length === 0}}" class="empty-tip">该日无订单</view>
    <view class="order-list">
      <view class="order-card card {{item.status === 'cancelled' ? 'cancelled' : ''}}"
            wx:for="{{detailOrders}}" wx:key="_id">
        <view class="order-header">
          <text class="order-status tag-{{item.status}}">{{statusText[item.status]}}</text>
          <text class="order-time" wx:if="{{item.create_time_str}}">{{item.create_time_str}}</text>
        </view>
        <view class="order-items">
          <text wx:for="{{item.items}}" wx:for-item="prod" wx:key="name" class="order-item-tag">{{prod.name}}×{{prod.num}}</text>
        </view>
        <view class="order-footer">
          <text class="order-price">¥{{item.total_price}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
