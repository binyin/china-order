/* pages/admin/products.wxss */
.container {
  min-height: 100vh;
  background: #f5f5f5;
}
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.header-title {
  font-size: 40rpx;
  font-weight: bold;
}
.header-add {
  font-size: 30rpx;
  color: #ff6b35;
  padding: 10rpx 24rpx;
  border: 1rpx solid #ff6b35;
  border-radius: 20rpx;
}
.product-list {
  padding: 8rpx 0 40rpx;
}
.product-item.card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 12rpx 24rpx;
  padding: 24rpx 28rpx;
}
.product-info { flex: 1; }
.product-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 8rpx;
}
.product-meta {
  font-size: 28rpx;
  color: #ff6b35;
}
.product-actions {
  display: flex;
  gap: 16rpx;
}
.action-btn {
  font-size: 26rpx;
  padding: 8rpx 22rpx;
  border-radius: 8rpx;
}
.action-btn.edit {
  background: #e8f4fd;
  color: #2980b9;
}
.action-btn.delete {
  background: #fde8e8;
  color: #e74c3c;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}
.modal-box {
  background: #fff;
  width: 100%;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx 60rpx;
}
.modal-title {
  font-size: 38rpx;
  font-weight: bold;
  margin-bottom: 32rpx;
  text-align: center;
}
.form-item { margin-bottom: 24rpx; }
.form-label {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 10rpx;
}
.form-input {
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 32rpx;
  width: 100%;
  box-sizing: border-box;
}
.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 12rpx;
}
.modal-actions button {
  flex: 1;
  border-radius: 12rpx;
  font-size: 32rpx;
  padding: 22rpx 0;
  line-height: 1.4;
}
.btn-primary {
  background: #ff6b35;
  color: #fff;
  border: none;
}
.btn-secondary {
  background: #fff;
  color: #ff6b35;
  border: 2rpx solid #ff6b35;
}
