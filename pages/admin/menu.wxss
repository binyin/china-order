/* pages/admin/menu.wxss - 基于设计系统 */

.container {
  min-height: 100vh;
  background-color: var(--color-bg-page);
  padding-bottom: var(--spacing-8);
}

.header {
  background-color: var(--color-bg-card);
  padding: var(--spacing-5) var(--spacing-4);
  box-shadow: var(--shadow-sm);
}

.header-title {
  font-size: var(--font-size-xl);
  font-weight: var(--font-weight-bold);
  color: var(--color-text-primary);
}

/* Tab切换 */
.tab-bar {
  display: flex;
  background-color: var(--color-bg-card);
  border-bottom: 1rpx solid var(--color-border-light);
  position: sticky;
  top: 0;
  z-index: 90;
}

.tab-item {
  flex: 1;
  text-align: center;
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  padding: var(--spacing-4) 0;
  position: relative;
  transition: color var(--transition-fast);
}

.tab-item.active {
  color: var(--color-primary);
  font-weight: var(--font-weight-semibold);
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 25%;
  right: 25%;
  height: 4rpx;
  background-color: var(--color-primary);
  border-radius: 2rpx;
  animation: slideIn var(--transition-normal);
}

@keyframes slideIn {
  from { transform: scaleX(0); }
  to { transform: scaleX(1); }
}

/* 日期选择器 */
.date-selector {
  background-color: var(--color-bg-card);
  padding: var(--spacing-3) 0;
  box-shadow: var(--shadow-sm);
}

.date-scroll {
  white-space: nowrap;
  height: 140rpx;
  width: 100%;
  -webkit-overflow-scrolling: touch;
}

.date-list {
  display: inline-flex;
  padding: 0 var(--spacing-4);
}

.date-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-3) var(--spacing-4);
  margin-right: var(--spacing-3);
  border-radius: var(--radius-lg);
  background-color: var(--color-gray-50);
  min-width: 150rpx;
  transition: all var(--transition-normal);
  user-select: none;
}

.date-item.active {
  background-color: var(--color-primary);
  color: var(--color-white);
  transform: translateY(-2rpx);
  box-shadow: var(--shadow-md);
}

.date-display {
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-semibold);
  margin-bottom: var(--spacing-1);
}

.date-detail {
  font-size: var(--font-size-xs);
  opacity: 0.9;
}

.selected-date-info {
  text-align: center;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  margin-top: var(--spacing-3);
  padding: 0 var(--spacing-4);
}

/* 区块标题 */
.section-header {
  background-color: var(--color-bg-card);
  padding: var(--spacing-4);
  margin-top: var(--spacing-3);
  border-bottom: 1rpx solid var(--color-border-light);
}

.section-title {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

/* 移除计数显示 */
.section-count,
.section-count.hint {
  display: none;
}

.empty-inline {
  text-align: center;
  padding: var(--spacing-8) var(--spacing-4);
  color: var(--color-text-tertiary);
  font-size: var(--font-size-base);
}

/* 今日售卖列表 */
.today-list {
  padding: var(--spacing-3) 0;
}

.today-item {
  background-color: var(--color-bg-card);
  border-radius: var(--radius-lg);
  margin: 0 var(--spacing-4) var(--spacing-3);
  padding: var(--spacing-4);
  border-left: 6rpx solid var(--color-primary);
  box-shadow: var(--shadow-sm);
}

.today-info {
  flex: 1;
}

.today-name {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-2);
}

.today-meta {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  display: flex;
  align-items: center;
  gap: var(--spacing-4);
}

/* 发布时间显示 */
.publish-time {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  margin-top: var(--spacing-1);
}

.stock-inline {
  width: 100rpx;
  padding: var(--spacing-1) var(--spacing-2);
  border-radius: var(--radius-sm);
  background-color: var(--color-gray-50);
  border: 1rpx solid var(--color-border-medium);
  font-size: var(--font-size-sm);
  text-align: center;
}

.today-ordered {
  font-size: var(--font-size-sm);
  color: var(--color-primary);
  font-weight: var(--font-weight-semibold);
  margin: 0 var(--spacing-3);
}

.btn-remove {
  background-color: var(--color-white);
  color: var(--color-error);
  border: 1rpx solid var(--color-error);
  padding: var(--spacing-1) var(--spacing-3);
  font-size: var(--font-size-sm);
  min-height: auto;
}

.btn-remove:active {
  background-color: var(--color-error);
  color: var(--color-white);
}

/* 未上架产品列表 */
.unlisted-list {
  padding: var(--spacing-3) 0;
}

.unlisted-item {
  background-color: var(--color-bg-card);
  border-radius: var(--radius-lg);
  margin: 0 var(--spacing-4) var(--spacing-3);
  padding: var(--spacing-4);
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--color-border-light);
  transition: transform var(--transition-fast);
}

.unlisted-item:active {
  transform: translateY(-2rpx);
}

.unlisted-info {
  flex: 1;
}

.unlisted-name {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-2);
}

.unlisted-price {
  font-size: var(--font-size-sm);
  color: var(--color-primary);
}

.stock-wrap {
  display: flex;
  align-items: center;
  gap: var(--spacing-2);
  margin: 0 var(--spacing-3);
}

.stock-label {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.stock-input {
  width: 100rpx;
  padding: var(--spacing-1) var(--spacing-2);
  border-radius: var(--radius-sm);
  background-color: var(--color-gray-50);
  border: 1rpx solid var(--color-border-medium);
  font-size: var(--font-size-base);
  text-align: center;
}

.btn-add {
  background-color: var(--color-primary);
  color: var(--color-white);
  border-radius: var(--radius-md);
  padding: var(--spacing-1) var(--spacing-3);
  font-size: var(--font-size-sm);
  min-height: auto;
}

.btn-add:active {
  background-color: var(--color-primary-dark);
}

/* 历史菜单 */
.history-list {
  padding: var(--spacing-3) 0 var(--spacing-12);
}

.history-day {
  background-color: var(--color-bg-card);
  border-radius: var(--radius-lg);
  margin: 0 var(--spacing-4) var(--spacing-3);
  padding: var(--spacing-4);
  box-shadow: var(--shadow-sm);
}

.history-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--spacing-3);
  padding-bottom: var(--spacing-2);
  border-bottom: 1rpx solid var(--color-border-light);
}

.history-date {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.btn-reuse {
  background-color: var(--color-primary);
  color: var(--color-white);
  border-radius: var(--radius-md);
  padding: var(--spacing-1) var(--spacing-4);
  font-size: var(--font-size-sm);
  min-height: auto;
}

.btn-reuse:active {
  background-color: var(--color-primary-dark);
}

.history-items {
  line-height: var(--line-height-relaxed);
}

.history-tag {
  display: inline-block;
  background-color: var(--color-gray-50);
  color: var(--color-text-primary);
  font-size: var(--font-size-sm);
  padding: var(--spacing-1) var(--spacing-3);
  border-radius: var(--radius-full);
  margin: 0 var(--spacing-1) var(--spacing-1) 0;
  border: 1rpx solid var(--color-border-light);
}

/* 提示条 */
.tip-bar {
  background-color: var(--color-primary-light);
  color: var(--color-text-primary);
  font-size: var(--font-size-sm);
  padding: var(--spacing-3) var(--spacing-4);
  border-bottom: 1rpx solid rgba(255, 107, 53, 0.2);
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: var(--spacing-20) 0;
  color: var(--color-text-tertiary);
  font-size: var(--font-size-md);
}

/* 空状态提示 */
.empty-tip {
  text-align: center;
  padding: var(--spacing-20) var(--spacing-4);
  color: var(--color-text-tertiary);
  font-size: var(--font-size-md);
}
