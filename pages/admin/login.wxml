<!--pages/admin/login.wxml-->
<view class="container">
  <view class="logo-area">
    <view class="logo-icon">🍞</view>
    <view class="logo-title">馒头店管理</view>
    <view class="logo-sub">店主专属入口</view>
  </view>

  <view class="form-card card">
    <view class="form-item">
      <view class="form-label">手机号</view>
      <input class="form-input" type="number" placeholder="请输入手机号" value="{{username}}" bindinput="onUsernameInput" maxlength="20" />
    </view>
    <view class="form-item">
      <view class="form-label">密码</view>
      <input class="form-input" password placeholder="请输入密码" value="{{password}}" bindinput="onPasswordInput" />
    </view>
    <button class="btn-login" bindtap="doLogin" loading="{{loading}}">登 录</button>
  </view>
</view>
